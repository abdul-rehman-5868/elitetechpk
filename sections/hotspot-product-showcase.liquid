<script
  src="{{ 'hotspot-product-showcase.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign lifestyle_image = section.settings.image
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign max_hotspots = 2
%}

<hotspot-product-showcase
  class="hotspot-product-showcase"
  style="
    --hps-radius: {{ section.settings.corner_radius }}px;
    --hps-gap: {{ section.settings.gap }}px;
    --hps-card-bg: {{ section.settings.card_background }};
    --hps-accent: {{ section.settings.accent_color }};
    --hps-hotspot: {{ section.settings.hotspot_color }};
    --hps-bullseye: {{ section.settings.bullseye_color }};
    {% render 'spacing-padding', settings: section.settings %}
  "
  data-active-index="0"
  {{ section.shopify_attributes }}
>
  <div class="hps">
    <div class="hps__layout">
      <div class="hps__media">
        {% if lifestyle_image != blank %}
          {{
            lifestyle_image
            | image_url: width: 3200
            | image_tag:
              widths: '800, 1200, 1600, 2000, 2400, 3200',
              sizes: '(min-width: 990px) 62vw, 100vw',
              class: 'hps__lifestyle-image',
              loading: 'lazy',
              alt: heading
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hps__lifestyle-image hps__placeholder' }}
        {% endif %}

        <div class="hps__hotspots">
          {% for block in section.blocks limit: max_hotspots %}
            {% liquid
              assign hotspot_product = block.settings.product
              if hotspot_product == blank
                assign hotspot_product = collections.all.products[forloop.index0]
              endif
              assign product_title = hotspot_product.title | default: 'Product'
            %}
            <button
              type="button"
              class="hps__hotspot{% if forloop.first %} is-active{% endif %}"
              style="
                left: {{ block.settings.x_position }}%;
                top: {{ block.settings.y_position }}%;
              "
              data-hps-hotspot
              data-product-index="{{ forloop.index0 }}"
              aria-label="Show {{ product_title | escape }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span class="hps__hotspot-ring" aria-hidden="true"></span>
              <span class="hps__hotspot-core" aria-hidden="true"></span>
            </button>
          {% endfor %}
        </div>
      </div>

      <div class="hps__aside">
        {% if eyebrow != blank %}
          <p class="hps__eyebrow">{{ eyebrow }}</p>
        {% endif %}

        {% if heading != blank %}
          {% liquid
            assign heading_words = heading | split: ' '
            assign heading_lead = heading_words | first
            assign accent_words = ''
            for word in heading_words
              unless forloop.first
                if accent_words == blank
                  assign accent_words = word
                else
                  assign accent_words = accent_words | append: ' ' | append: word
                endif
              endunless
            endfor
          %}
          <h2 class="hps__heading">
            {{ heading_lead }}
            {% if accent_words != blank %}
              <span class="hps__heading-accent">{{ accent_words }}</span>
            {% endif %}
          </h2>
        {% endif %}

        <div class="hps__products" aria-live="polite">
          <span class="visually-hidden" data-hps-live></span>

          {% for block in section.blocks limit: max_hotspots %}
            {% liquid
              assign product = block.settings.product
              if product == blank
                assign product = collections.all.products[forloop.index0]
              endif
              assign media_limit = 0
              if product != blank
                for media in product.media
                  if media.media_type == 'image' and media_limit < 3
                    assign media_limit = media_limit | plus: 1
                  endif
                endfor
              endif
              if media_limit == 0
                assign media_limit = 1
              endif
              assign rating_value = block.settings.rating
              if rating_value == blank and product != blank
                assign rating_value = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value
              endif
              assign cta_label = section.settings.button_label
            %}

            <article
              class="hps__product{% if forloop.first %} is-active{% endif %}"
              data-hps-panel
              data-product-title="{{ product.title | default: 'Product' | escape }}"
              {% unless forloop.first %}
                hidden
              {% endunless %}
              aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            >
              <div
                class="hps__gallery"
                data-hps-gallery
                data-media-count="{{ media_limit }}"
                data-active-media="0"
              >
                <div class="hps__track" data-hps-track>
                  {% liquid
                    assign rendered_media = 0
                  %}
                  {% if product != blank %}
                    {% for media in product.media %}
                      {% if media.media_type == 'image' and rendered_media < 3 %}
                        <div class="hps__slide">
                          {{
                            media
                            | image_url: width: 1200
                            | image_tag:
                              widths: '400, 600, 800, 1000, 1200',
                              sizes: '(min-width: 990px) 28vw, 90vw',
                              class: 'hps__product-image',
                              loading: 'lazy',
                              alt: product.title
                          }}
                        </div>
                        {% assign rendered_media = rendered_media | plus: 1 %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                  {% if rendered_media == 0 %}
                    <div class="hps__slide">
                      {% if product.featured_image != blank %}
                        {{
                          product.featured_image
                          | image_url: width: 1200
                          | image_tag:
                            widths: '400, 600, 800, 1000, 1200',
                            sizes: '(min-width: 990px) 28vw, 90vw',
                            class: 'hps__product-image',
                            loading: 'lazy',
                            alt: product.title
                        }}
                      {% else %}
                        {{ 'product-apparel-1' | placeholder_svg_tag: 'hps__product-image hps__placeholder' }}
                      {% endif %}
                    </div>
                  {% endif %}
                </div>

                <div class="hps__zones" aria-hidden="true">
                  <span class="hps__zone"></span>
                  <span class="hps__zone"></span>
                  <span class="hps__zone"></span>
                </div>

                {% if rating_value != blank %}
                  <div class="hps__rating" aria-label="Rating {{ rating_value }}">
                    <span class="hps__rating-star" aria-hidden="true">★</span>
                    <span>{{ rating_value }}</span>
                  </div>
                {% endif %}

                {% if product != blank and cta_label != blank %}
                  <a class="hps__cta" href="{{ product.url }}">{{ cta_label }}</a>
                {% endif %}

                {% if media_limit > 1 %}
                  <div class="hps__dots" role="group" aria-label="Product images">
                    {% for i in (1..media_limit) %}
                      <button
                        type="button"
                        class="hps__dot{% if forloop.first %} is-active{% endif %}"
                        data-hps-dot
                        aria-label="Show image {{ forloop.index }}"
                        aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                      ></button>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>

              <div class="hps__meta">
                {% if product != blank %}
                  {% if product.vendor != blank %}
                    <p class="hps__vendor">{{ product.vendor }}</p>
                  {% endif %}

                  <div class="hps__title-row">
                    <h3 class="hps__product-title">
                      <a href="{{ product.url }}">{{ product.title }}</a>
                    </h3>
                    <div class="hps__price">
                      {% render 'price', product_resource: product %}
                    </div>
                  </div>

                  {% liquid
                    assign thumb_count = 0
                    assign shown_images = ''
                  %}
                  <div class="hps__thumbs">
                    {% for variant in product.variants %}
                      {% if variant.featured_image != blank %}
                        {% assign image_id = variant.featured_image.id | append: '' %}
                        {% unless shown_images contains image_id %}
                          {% if thumb_count < 3 %}
                            <span class="hps__thumb{% if thumb_count == 0 %} is-active{% endif %}">
                              {{
                                variant.featured_image
                                | image_url: width: 120
                                | image_tag:
                                  widths: '80, 120',
                                  sizes: '40px',
                                  loading: 'lazy',
                                  alt: variant.title
                              }}
                            </span>
                            {% assign shown_images = shown_images | append: image_id | append: ',' %}
                            {% assign thumb_count = thumb_count | plus: 1 %}
                          {% endif %}
                        {% endunless %}
                      {% endif %}
                    {% endfor %}

                    {% if thumb_count == 0 %}
                      {% assign media_thumb_count = 0 %}
                      {% for media in product.media %}
                        {% if media.media_type == 'image' and media_thumb_count < 3 %}
                          <span class="hps__thumb{% if media_thumb_count == 0 %} is-active{% endif %}">
                            {{
                              media
                              | image_url: width: 120
                              | image_tag:
                                widths: '80, 120',
                                sizes: '40px',
                                loading: 'lazy',
                                alt: product.title
                            }}
                          </span>
                          {% assign media_thumb_count = media_thumb_count | plus: 1 %}
                        {% endif %}
                      {% endfor %}
                    {% endif %}
                  </div>
                {% else %}
                  <p class="hps__vendor">Brand</p>
                  <div class="hps__title-row">
                    <h3 class="hps__product-title">Select a product</h3>
                    <div class="hps__price">
                      {% render 'price', product_resource: blank %}
                    </div>
                  </div>
                {% endif %}
              </div>

              {% if product != blank and cta_label != blank %}
                {% comment %}
                  Compact mobile card only — the desktop reference layout keeps
                  its own overlay .hps__cta inside .hps__gallery above. Kept
                  as a separate element (not a relocation of the one above)
                  since the two need different DOM positions for their
                  respective layouts and there's no product-count/id
                  collision risk (plain link, no theme-block identity).
                {% endcomment %}
                <a class="hps__cta-compact" href="{{ product.url }}">
                  <span class="hps__cta-compact-icon" aria-hidden="true">+</span>
                  <span>{{ cta_label }}</span>
                </a>
              {% endif %}
            </article>
          {% endfor %}

          {% if section.blocks.size == 0 %}
            <article class="hps__product is-active" data-hps-panel data-product-title="Product">
              <div class="hps__gallery" data-hps-gallery data-media-count="1" data-active-media="0">
                <div class="hps__track" data-hps-track>
                  <div class="hps__slide">
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'hps__product-image hps__placeholder' }}
                  </div>
                </div>
              </div>
              <div class="hps__meta">
                <p class="hps__vendor">Brand</p>
                <div class="hps__title-row">
                  <h3 class="hps__product-title">Add hotspot products</h3>
                </div>
              </div>
            </article>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</hotspot-product-showcase>

{% stylesheet %}
  /* Outside: X 0 (edge-to-edge). Inside: X uses --homepage-gutter on .hps. Y via theme editor. */
  .hotspot-product-showcase-section {
    --hp-shell-pad-x-mobile: 0px;
    --hp-shell-pad-x-desktop: 0px;
  }

  .hotspot-product-showcase {
    display: block;
    background: #ffffff;
    border-radius: var(--hps-radius, 17px) var(--hps-radius, 17px) 0 0;
    overflow: clip;
  }

  .hps {
    padding-inline: var(--homepage-gutter);
    padding-block-start: var(--hp-pad-y-start-mobile, var(--padding-block-start, 0));
    padding-block-end: var(--hp-pad-y-end-mobile, var(--padding-block-end, 0));
  }

  @media screen and (min-width: 750px) {
    .hps {
      padding-block-start: var(--hp-pad-y-start-desktop, var(--padding-block-start, 0));
      padding-block-end: var(--hp-pad-y-end-desktop, var(--padding-block-end, 0));
    }
  }

  /* Title (eyebrow + heading) on top, centered; lifestyle image below sized
     to the remaining viewport; product cards below that — same order and
     centered title on both desktop and mobile now (previously a 2-column
     grid with the title beside the image only on desktop). */
  .hps__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  .hps__media {
    position: relative;
    order: 2;
    border-radius: var(--hps-radius, 17px);
    overflow: hidden;
    background: #ececec;
    /* Responsive height via aspect-ratio instead of a viewport-height calc.
       The previous height: calc(100svh - header-height) lived on
       .hps__layout (the whole title+image+cards stack), squeezing
       everything into one viewport height and letting
       .hotspot-product-showcase's overflow: clip cut off the product cards
       below the image. aspect-ratio scales with the section's own width
       instead of fighting with page height, so the cards below always get
       the room they need on both breakpoints. */
    width:100%;
    min-height: 20rem;
    max-height: 34rem;
    margin-block-end: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media screen and (min-width: 750px) {
    .hps__media {
      aspect-ratio: 16 / 9;
      max-height: 42rem;
    }
  }

  .hps__lifestyle-image,
  .hps__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hps__hotspots {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hps__hotspot {
    position: absolute;
    width: 2.25rem;
    height: 2.25rem;
    transform: translate(-50%, -50%);
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
    z-index: 2;
  }

  .hps__hotspot-ring,
  .hps__hotspot-core {
    position: absolute;
    inset: 50% auto auto 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .hps__hotspot-ring {
    width: 2.15rem;
    height: 2.15rem;
    background: color-mix(in srgb, var(--hps-hotspot, #ffffff) 45%, transparent);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.35);
  }

  .hps__hotspot-core {
    width: 0.78rem;
    height: 0.78rem;
    background: var(--hps-bullseye, #ffffff);
  }

  .hps__hotspot.is-active .hps__hotspot-ring,
  .hps__hotspot:hover .hps__hotspot-ring,
  .hps__hotspot:focus-visible .hps__hotspot-ring {
    width: 2.45rem;
    height: 2.45rem;
    background: color-mix(in srgb, var(--hps-hotspot, #ffffff) 65%, transparent);
  }

  .hps__hotspot:focus-visible {
    outline: 2px solid #111111;
    outline-offset: 3px;
    border-radius: 999px;
  }

  /* Flattened so eyebrow/heading/products can each get their own `order`
     against .hps__media, rather than moving as one block. */
  .hps__aside {
    display: contents;
  }

  .hps__eyebrow {
    order: 0;
    margin: 0 0 0.5rem;
    text-align: center;
    color: #8a8a8a;
    font-size: 0.8125rem;
    line-height: 1.3;
    letter-spacing: 0.02em;
    font-weight: 400;
  }

  .hps__heading {
    order: 1;
    margin: 0 auto clamp(1.5rem, 3vw, 2.5rem);
    max-width: 22ch;
    text-align: center;
    font-size: clamp(2rem, 3.6vw, 3.15rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 700;
    color: #111111;
  }

  .hps__heading-accent {
    position: relative;
    display: inline;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    background-image:
      radial-gradient(closest-side at 12% 60%, var(--hps-accent, #e8b089) 92%, transparent 93%),
      radial-gradient(closest-side at 50% 40%, var(--hps-accent, #e8b089) 92%, transparent 93%);
    background-size: 0.5em 0.2em, 0.65em 0.2em;
    background-position: 0 100%, 0.22em calc(100% + 0.04em);
    background-repeat: repeat-x;
    padding-bottom: 0.12em;
  }

  .hps__products {
    order: 3;
    position: relative;
    width: 100%;
  }

  @media screen and (max-width: 989px) {
    /* Compact, full-width, horizontally scrollable cards — one card fills
       the viewport width at a time, swipe for the other (see
       #setActiveProduct's scrollIntoView call in the JS, which scrolls the
       matching card into view when its hotspot is tapped). */
    .hps__products {
      display: flex;
      gap: 0.65rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }

    .hps__products::-webkit-scrollbar {
      display: none;
    }
  }

  @media screen and (min-width: 990px) {
    /* Both cards side by side, left and right. */
    .hps__products {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
  }

  /* Compact card (thumbnail + vendor/name/price + button) on both
     breakpoints now — both hotspot products stay visible at once instead of
     the old single-panel swap. */
  .hps__product {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem;
    border-radius: var(--hps-radius, 17px);
    background: var(--hps-card-bg, #f7f7f7);
    outline: 2px solid transparent;
    outline-offset: -2px;
    transition: outline-color 0.2s ease;
  }

  /* Visual feedback for which card a hovered/tapped hotspot maps to, now
     that both stay visible rather than one swapping in. */
  .hps__product.is-active {
    outline-color: var(--hps-accent, #e8b089);
  }

  .hps__product[hidden] {
    display: flex !important;
  }

  @media screen and (max-width: 989px) {
    .hps__product {
      flex: 0 0 auto;
      width: 100%;
      scroll-snap-align: start;
    }
  }

  .hps__gallery {
    position: relative;
    flex: 0 0 auto;
    width: 5.5rem;
    height: 5.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: calc(var(--hps-radius, 17px) * 0.6);
    background: var(--hps-card-bg, #f7f7f7);
    cursor: default;
    touch-action: pan-y;
  }

  .hps__track {
    display: flex;
    width: 100%;
    height: 100%;
    transform: translate3d(0, 0, 0);
    transition: transform 0.28s ease;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .hps__track {
      transition: none;
    }
  }

  .hps__slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
  }

  .hps__product-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    padding: 0.35rem;
    background: var(--hps-card-bg, #f7f7f7);
  }

  /* Desktop-only gallery chrome from the old rich single-panel layout
     (multi-image hover zones, rating badge, overlay CTA, image dots) has no
     room in the compact card used on both breakpoints now. Left in the DOM
     (harmless, JS still runs) rather than removed, to keep this change
     scoped to layout/CSS. */
  .hps__zones,
  .hps__rating,
  .hps__cta,
  .hps__dots {
    display: none;
  }

  .hps__rating {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    z-index: 3;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    color: #111111;
    font-size: 0.8rem;
    font-weight: 600;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.08);
  }

  .hps__rating-star {
    color: var(--hps-accent, #e8b089);
    font-size: 0.85rem;
    line-height: 1;
  }

  .hps__cta {
    position: absolute;
    left: 50%;
    right: auto;
    bottom: 2.4rem;
    z-index: 4;
    transform: translateX(-50%);
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.15rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, color 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
  }

  .hps__gallery:hover .hps__cta,
  .hps__gallery:focus-within .hps__cta {
    opacity: 1;
    pointer-events: auto;
  }

  .hps__cta:focus-visible {
    opacity: 1;
    pointer-events: auto;
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .hps__dots {
    position: absolute;
    left: 50%;
    bottom: 0.85rem;
    z-index: 3;
    transform: translateX(-50%);
    align-items: center;
    gap: 0.4rem;
    padding: 0;
    background: transparent;
  }

  .hps__dot {
    width: 0.35rem;
    height: 0.35rem;
    border: 1.5px solid transparent;
    border-radius: 999px;
    padding: 0;
    background: #111111;
    cursor: pointer;
  }

  .hps__dot.is-active {
    background: transparent;
    border-color: #111111;
    width: 0.45rem;
    height: 0.45rem;
  }

  .hps__meta {
    display: grid;
    flex: 1 1 auto;
    min-width: 0;
    gap: 0.2rem;
  }

  .hps__vendor {
    margin: 0;
    color: #9a9a9a;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 400;
  }

  .hps__title-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
  }

  .hps__product-title {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    font-weight: 700;
    color: #111111;
  }

  .hps__product-title a {
    color: inherit;
    text-decoration: none;
  }

  .hps__product-title a:hover {
    text-decoration: underline;
  }

  .hps__price {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #111111;
    white-space: nowrap;
  }

  .hps__price .price,
  .hps__price .price__regular,
  .hps__price .price-item {
    font-size: inherit;
    font-weight: inherit;
  }

  .hps__thumbs {
    display: none;
  }

  .hps__cta-compact {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    background: #111111;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .hps__cta-compact-icon {
    font-size: 1rem;
    line-height: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hotspot product showcase",
  "tag": "section",
  "class": "hotspot-product-showcase-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 2,
  "blocks": [
    {
      "type": "hotspot_product",
      "name": "Hotspot product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "x_position",
