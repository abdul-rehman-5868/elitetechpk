{% liquid
  assign heading = section.settings.heading
  assign included_heading = section.settings.included_heading
%}

<script
  src="{{ 'product-tech-specs.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<product-tech-specs
  id="ProductFeatures"
  class="product-tech-specs section spacing-style"
  style="
    --product-story-content-inset: clamp(1.25rem, 6vw, 15vw);
    --pts-radius: {{ section.settings.corner_radius }}px;
    --pts-bg: {{ section.settings.background_color }};
    --pts-panel: {{ section.settings.panel_color }};
    --pts-sticky-top: calc(
      var(--header-group-height, var(--header-height, 0px)) + 30px + var(--product-story-toc-height, 3rem) + 12px
    );
    {% render 'spacing-style', settings: section.settings %}
  "
  {{ section.shopify_attributes }}
>
  <div class="product-tech-specs__layout">
    <div class="product-tech-specs__main">
      {% if heading != blank %}
        <h2 class="product-tech-specs__heading">{{ heading | escape }}</h2>
      {% endif %}

      <div class="product-tech-specs__accordion">
        {% for block in section.blocks %}
          {% if block.type != 'spec_group' %}{% continue %}{% endif %}
          <details
            class="product-tech-specs__group"
            {% if block.settings.open_by_default %}open{% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="product-tech-specs__summary">
              <span>{{ block.settings.title | escape }}</span>
              <span class="product-tech-specs__icon" aria-hidden="true">
                <span class="product-tech-specs__icon-plus">
                  <span class="svg-wrapper">{{ 'icon-plus.svg' | inline_asset_content }}</span>
                </span>
                <span class="product-tech-specs__icon-close">
                  <span class="svg-wrapper">{{ 'icon-accordion-close.svg' | inline_asset_content }}</span>
                </span>
              </span>
            </summary>
            <div class="product-tech-specs__panel">
              <div class="product-tech-specs__grid">
                {% if block.settings.col_1_heading != blank or block.settings.col_1_body != blank %}
                  <div class="product-tech-specs__col">
                    {% if block.settings.col_1_heading != blank %}
                      <h3 class="product-tech-specs__col-heading">{{ block.settings.col_1_heading | escape }}</h3>
                    {% endif %}
                    {% if block.settings.col_1_body != blank %}
                      <div class="product-tech-specs__col-body rte">{{ block.settings.col_1_body }}</div>
                    {% endif %}
                  </div>
                {% endif %}
                {% if block.settings.col_2_heading != blank or block.settings.col_2_body != blank %}
                  <div class="product-tech-specs__col">
                    {% if block.settings.col_2_heading != blank %}
                      <h3 class="product-tech-specs__col-heading">{{ block.settings.col_2_heading | escape }}</h3>
                    {% endif %}
                    {% if block.settings.col_2_body != blank %}
                      <div class="product-tech-specs__col-body rte">{{ block.settings.col_2_body }}</div>
                    {% endif %}
                  </div>
                {% endif %}
                {% if block.settings.col_3_heading != blank or block.settings.col_3_body != blank %}
                  <div class="product-tech-specs__col">
                    {% if block.settings.col_3_heading != blank %}
                      <h3 class="product-tech-specs__col-heading">{{ block.settings.col_3_heading | escape }}</h3>
                    {% endif %}
                    {% if block.settings.col_3_body != blank %}
                      <div class="product-tech-specs__col-body rte">{{ block.settings.col_3_body }}</div>
                    {% endif %}
                  </div>
                {% endif %}
                {% if block.settings.col_4_heading != blank or block.settings.col_4_body != blank %}
                  <div class="product-tech-specs__col">
                    {% if block.settings.col_4_heading != blank %}
                      <h3 class="product-tech-specs__col-heading">{{ block.settings.col_4_heading | escape }}</h3>
                    {% endif %}
                    {% if block.settings.col_4_body != blank %}
                      <div class="product-tech-specs__col-body rte">{{ block.settings.col_4_body }}</div>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          </details>
        {% endfor %}
      </div>
    </div>

    <aside class="product-tech-specs__aside">
      <div class="product-tech-specs__included-package">
        <div class="product-tech-specs__included-handle" aria-hidden="true">
          <span class="product-tech-specs__included-handle-pill"></span>
          <span class="product-tech-specs__included-handle-circle"></span>
        </div>

        <div class="product-tech-specs__included">
        {% if included_heading != blank %}
          <h3 class="product-tech-specs__included-heading">{{ included_heading | escape }}</h3>
        {% endif %}

        {% liquid
          assign included_item_index = 0
          assign included_item_count = 0
          for block in section.blocks
            if block.type == 'included_item'
              assign included_item_count = included_item_count | plus: 1
            endif
          endfor
        %}

        {% if included_item_count > 0 %}
          <div class="product-tech-specs__included-grid">
            <ul class="product-tech-specs__included-row" role="list">
              {% for block in section.blocks %}
                {% if block.type != 'included_item' %}{% continue %}{% endif %}
                {% if included_item_index >= 3 %}{% break %}{% endif %}
                {% render 'product-tech-specs-included-item', block: block %}
                {% assign included_item_index = included_item_index | plus: 1 %}
              {% endfor %}
            </ul>

            {% if included_item_count > 3 %}
              <ul
                class="product-tech-specs__included-row product-tech-specs__included-row--center"
                role="list"
              >
                {% assign included_item_index = 0 %}
                {% for block in section.blocks %}
                  {% if block.type != 'included_item' %}{% continue %}{% endif %}
                  {% if included_item_index < 3 %}
                    {% assign included_item_index = included_item_index | plus: 1 %}
                    {% continue %}
                  {% endif %}
                  {% render 'product-tech-specs-included-item', block: block %}
                  {% assign included_item_index = included_item_index | plus: 1 %}
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        {% endif %}
        </div>
      </div>
    </aside>
  </div>
</product-tech-specs>

{% stylesheet %}
  .product-tech-specs {
    display: block;
    background: var(--pts-bg, #f4f4f4);
    color: #111111;
  }

  .product-tech-specs__layout {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--product-story-content-inset, clamp(1.25rem, 6vw, 15vw));
    box-sizing: border-box;
  }

  .product-tech-specs__heading {
    margin: 0 0 2rem;
    font-family: var(--font-body--family);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 700;
    text-transform: none;
    color: #111111;
  }

  .product-tech-specs__accordion {
    display: flex;
    flex-direction: column;
    border-top: 1px solid #eeeeee;
  }

  .product-tech-specs__group {
    border-bottom: 1px solid #eeeeee;
  }

  .product-tech-specs__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.35rem 0;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-body--family);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.45;
    text-transform: none;
    color: #111111;
  }

  .product-tech-specs__summary:hover,
  .product-tech-specs__summary:focus-visible {
    color: #111111;
  }

  .product-tech-specs__summary::-webkit-details-marker {
    display: none;
  }

  .product-tech-specs__icon {
    position: relative;
    width: 0.75rem;
    height: 0.75rem;
    flex: none;
    --icon-stroke-width: 1px;
    color: #111111;
  }

  .product-tech-specs__icon-plus,
  .product-tech-specs__icon-close {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: opacity 220ms ease, transform 280ms ease;
  }

  .product-tech-specs__icon-plus .svg-wrapper,
  .product-tech-specs__icon-close .svg-wrapper {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  .product-tech-specs__icon-plus svg,
  .product-tech-specs__icon-close svg {
    width: 100%;
    height: 100%;
  }

  .product-tech-specs__icon-close {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .product-tech-specs__group[open] .product-tech-specs__icon-plus {
    opacity: 0;
    transform: rotate(90deg);
  }

  .product-tech-specs__group[open] .product-tech-specs__icon-close {
    opacity: 1;
    transform: rotate(0deg);
  }

  .product-tech-specs__panel {
    overflow: hidden;
    transition: height 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .product-tech-specs__group:not([open]) > .product-tech-specs__panel {
    height: 0;
  }

  .product-tech-specs__group[open] > .product-tech-specs__panel {
    height: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-tech-specs__panel,
    .product-tech-specs__icon-plus,
    .product-tech-specs__icon-close {
      transition: none;
    }
  }

  .product-tech-specs__panel .product-tech-specs__grid {
    padding: 0.35rem 0 1.75rem;
  }

  .product-tech-specs__grid {
    display: grid;
    gap: 2rem 2.5rem;
  }

  .product-tech-specs__col {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .product-tech-specs__col-heading {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    text-transform: none;
    letter-spacing: -0.01em;
    color: #111111;
  }

  .product-tech-specs__col-body {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.6;
    color: #666666;
  }

  .product-tech-specs__col-body p {
    margin: 0;
  }

  .product-tech-specs__col-body > *:first-child {
    margin-block-start: 0;
  }

  .product-tech-specs__col-body > *:last-child {
    margin-block-end: 0;
  }

  .product-tech-specs__aside {
    min-width: 0;
    overflow: visible;
  }

  .product-tech-specs__included-package {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .product-tech-specs__included-handle {
    position: relative;
    flex: none;
    width: 8rem;
    height: 2.5rem;
    border-radius: 1rem 1rem 0 0;
    background: #111111;
  }

  .product-tech-specs__included-handle-pill {
    position: absolute;
    left: 50%;
    bottom: 0.5rem;
    width: 3.25rem;
    height: 0.75rem;
    border-radius: 999px;
    background: var(--pts-bg, #f4f4f4);
    transform: translateX(-50%);
  }

  .product-tech-specs__included-handle-circle {
    position: absolute;
    left: 50%;
    bottom: calc(0.5rem + 0.75rem);
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--pts-bg, #f4f4f4);
    transform: translate(-50%, 50%);
  }

  .product-tech-specs__included {
    width: 100%;
    padding: 1.75rem 1.75rem 1.75rem;
    border-radius: var(--pts-radius, 28px);
    background: var(--pts-panel, #f7f7f7);
  }

  .product-tech-specs__included-heading {
    margin: 0 0 1.5rem;
    text-align: center;
    font-family: var(--font-body--family);
    font-size: clamp(1.125rem, 1.5vw, 1.35rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #111111;
  }

  .product-tech-specs__included-grid {
    display: grid;
    gap: 1.35rem;
  }

  .product-tech-specs__included-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(0.85rem, 2.5vw, 1.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-tech-specs__included-row--center {
    justify-content: center;
  }

  .product-tech-specs__included-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 6.5rem;
    text-align: center;
  }

  .product-tech-specs__included-icon {
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 0 1px rgb(17 17 17 / 6%);
    flex: none;
  }

  .product-tech-specs__included-svg {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    color: #111111;
  }

  .product-tech-specs__included-svg svg {
    width: 100%;
    height: 100%;
  }

  .product-tech-specs__included-image {
    width: 2.25rem;
    height: 2.25rem;
    object-fit: contain;
  }

  .product-tech-specs__included-label {
    margin-block-start: 0.5rem;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.4;
    color: #444444;
  }

  @media screen and (min-width: 990px) {
    .product-tech-specs__layout {
      width: 100%;
      max-width: 100%;
      padding-inline: var(--homepage-content-x-desktop, clamp(0.5rem, 2vw, 15vw));
      grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.72fr);
      gap: clamp(1.75rem, 3vw, 3rem);
    }

    .product-tech-specs__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .product-tech-specs__aside {
      position: sticky;
      top: var(--pts-sticky-top);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product tech specs",
  "tag": "section",
  "class": "product-tech-specs-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tech Specs"
    },
    {
      "type": "text",
      "id": "included_heading",
      "label": "Included heading",
      "default": "Included in the Box"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Included panel",
      "default": "#F7F7F7"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Included corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
