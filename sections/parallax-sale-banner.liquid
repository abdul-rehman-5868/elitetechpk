{% liquid
  assign image = section.settings.image
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link

  case section.settings.height
    when 'small'
      assign min_height = '28rem'
    when 'medium'
      assign min_height = '36rem'
    when 'large'
      assign min_height = '44rem'
    when 'full'
      assign min_height = 'calc(100svh - var(--header-height, 0px))'
    else
      assign min_height = '36rem'
  endcase

  assign overlay_opacity = section.settings.overlay_opacity | times: 0.01
  assign object_position = section.settings.image_position | default: 'center center'
%}

<script
  src="{{ 'parallax-sale-banner.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<parallax-sale-banner
  class="parallax-sale-banner hp-inner-pad"
  style="
    --psb-min-height: {{ min_height }};
    --psb-overlay: rgb(0 0 0 / {{ overlay_opacity }});
    --psb-text: {{ section.settings.text_color }};
    --psb-button-bg: {{ section.settings.button_background }};
    --psb-button-fg: {{ section.settings.button_text_color }};
    --psb-radius: {{ section.settings.corner_radius }}px;
    --psb-panel-radius: {{ section.settings.corner_radius }}px;
    --psb-content-max: {{ section.settings.content_max_width }}rem;
    --psb-media-scale: 1.18;
    --psb-object-position: {{ object_position }};
    --hp-pad-x-mobile: 0px;
    --hp-pad-x-desktop: 0px;
    --psb-content-pad-x-mobile: 20px;
    --psb-content-pad-x-desktop: 40px;
    --psb-content-pad-y-mobile: 28px;
    --psb-content-pad-y-desktop: 52px;
    {% render 'spacing-padding', settings: section.settings %}
  "
  data-parallax-strength="{{ section.settings.parallax_strength }}"
  {{ section.shopify_attributes }}
>
  <div
    class="parallax-sale-banner__media"
    ref="media"
    aria-hidden="true"
  >
    {% if image != blank %}
      {{
        image
        | image_url: width: 3840
        | image_tag:
          widths: '832, 1200, 1600, 1920, 2560, 3840',
          sizes: '100vw',
          class: 'parallax-sale-banner__image',
          loading: 'lazy',
          alt: heading
      }}
    {% else %}
      {{ 'hero-apparel-2' | placeholder_svg_tag: 'parallax-sale-banner__image parallax-sale-banner__placeholder' }}
    {% endif %}
  </div>

  <div class="parallax-sale-banner__overlay" aria-hidden="true"></div>

  <div class="parallax-sale-banner__content">
    {% if heading != blank %}
      <h2 class="parallax-sale-banner__heading">{{ heading | newline_to_br }}</h2>
    {% endif %}

    {% if subheading != blank %}
      <p class="parallax-sale-banner__subheading">{{ subheading }}</p>
    {% endif %}

    {% if button_label != blank %}
      {% if button_link != blank %}
        <a class="parallax-sale-banner__button" href="{{ button_link }}">
          <span>{{ button_label }}</span>
          <span class="parallax-sale-banner__button-icon" aria-hidden="true">
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </span>
        </a>
      {% else %}
        <span class="parallax-sale-banner__button">
          <span>{{ button_label }}</span>
          <span class="parallax-sale-banner__button-icon" aria-hidden="true">
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </span>
        </span>
      {% endif %}
    {% endif %}
  </div>
</parallax-sale-banner>

{% stylesheet %}
  .parallax-sale-banner {
    position: relative;
    display: grid;
    min-height: var(--psb-min-height, 36rem);
    border-radius: var(--psb-radius, 17px);
    overflow: hidden;
    color: var(--psb-text, #ffffff);
    background: #6b6b6b;
    isolation: isolate;
  }

  @media screen and (max-width: 749px) {
    .parallax-sale-banner {
      /* Same mobile height treatment as the Immersive Video Banner above:
         slightly shorter than the desktop-tuned height presets. */
      min-height: calc(var(--psb-min-height, 36rem) * 0.85);
    }

    .parallax-sale-banner__content {
      gap: 0.65rem;
    }
  }

  .parallax-sale-banner__media,
  .parallax-sale-banner__overlay,
  .parallax-sale-banner__content {
    grid-area: 1 / 1;
  }

  .parallax-sale-banner__media {
    position: absolute;
    inset: -9% 0;
    z-index: 0;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  .parallax-sale-banner__image,
  .parallax-sale-banner__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--psb-object-position, center center);
    transform: scale(var(--psb-media-scale, 1.18));
  }

  .parallax-sale-banner__placeholder {
    background: #7a7a7a;
  }

  .parallax-sale-banner__overlay {
    position: relative;
    z-index: 1;
    background: var(--psb-overlay, rgb(0 0 0 / 0.28));
    pointer-events: none;
  }

  .parallax-sale-banner__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.85rem;
    padding-block: var(--psb-content-pad-y-mobile, 28px);
    padding-inline: var(--psb-content-pad-x-mobile, 20px);
    max-width: min(100%, calc(var(--psb-content-max, 36) * 1rem));
    margin-inline: auto;
    pointer-events: none;
  }

  @media screen and (min-width: 750px) {
    .parallax-sale-banner__content {
      padding-block: var(--psb-content-pad-y-desktop, 52px);
      padding-inline: var(--psb-content-pad-x-desktop, 40px);
    }
  }

  .parallax-sale-banner__heading {
    margin: 0;
    font-size: clamp(1.85rem, 4.8vw, 3.25rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-weight: 600;
    text-wrap: balance;
  }

  .parallax-sale-banner__subheading {
    margin: 0;
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    line-height: 1.45;
    max-width: 36ch;
    opacity: 0.95;
  }

  .parallax-sale-banner__button {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.65rem;
    padding: 0.85rem 1.45rem;
    border-radius: 999px;
    background: var(--psb-button-bg, #ffffff);
    color: var(--psb-button-fg, #111111);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .parallax-sale-banner__button:hover {
    opacity: 0.92;
  }

  .parallax-sale-banner__button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .parallax-sale-banner__button-icon {
    display: inline-flex;
    width: 0.9rem;
    height: 0.9rem;
  }

  .parallax-sale-banner__button-icon svg {
    width: 100%;
    height: 100%;
  }

  .parallax-sale-banner[data-reduced-motion] .parallax-sale-banner__media {
    will-change: auto;
    transform: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .parallax-sale-banner__button {
      transition: none;
    }

    .parallax-sale-banner__media {
      will-change: auto;
      transform: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Parallax sale banner",
  "tag": "section",
  "class": "parallax-sale-banner-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "center left", "label": "Left" },
        { "value": "center right", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "parallax_strength",
      "label": "Parallax strength",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48,
      "info": "How far the background image shifts vertically while scrolling."
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Top corner radius",
      "min": 0,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Get up to 50% off\non waterproof speakers"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover sales"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "rem",
      "default": 34
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 28
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Parallax sale banner",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
