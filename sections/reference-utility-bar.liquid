{% liquid
  assign show_language = section.settings.show_language
  if localization.available_languages.size <= 1
    assign show_language = false
  endif

  assign show_country = section.settings.show_country
  if localization.available_countries.size <= 1
    assign show_country = false
  endif

  assign autoplay = false
  assign show_arrows = false
  if section.blocks.size > 1
    assign autoplay = true
    assign show_arrows = true
  endif

  assign social_platforms = 'facebook,twitter,instagram,youtube' | split: ','
  assign lang_form_id = section.id | append: '-lang'
  assign country_form_id = section.id | append: '-country'
-%}

{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

<aside
  class="reference-utility-bar color-custom-{{ section.id }}"
  style="
    --utility-bg: {{ section.settings.background_color }};
    --utility-fg: {{ section.settings.text_color }};
    --utility-padding-block: {{ section.settings.padding_block }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="reference-utility-bar__inner">
    <div class="reference-utility-bar__social mobile:hidden">
      {% for platform in social_platforms %}
        {% liquid
          assign url_key = platform | append: '_url'
          assign link_url = section.settings[url_key]
        %}
        {% if link_url != blank %}
          <a
            class="reference-utility-bar__social-link"
            href="{{ link_url }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ platform | capitalize }}"
          >
            <svg
              class="reference-utility-bar__social-icon"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              width="20"
              height="20"
            >
              {%- render 'icon', icon: platform -%}
            </svg>
          </a>
        {% endif %}
      {% endfor %}
    </div>

    <announcement-bar-component
      class="reference-utility-bar__announcements"
      {% if autoplay %}
        autoplay="{{ section.settings.speed }}"
        aria-live="polite"
      {% endif %}
    >
      {% if show_arrows %}
        {% render 'slideshow-arrows', icon_style: 'chevron' %}
      {% endif %}

      <div class="reference-utility-bar__slides">
        {% content_for 'blocks' %}
      </div>
    </announcement-bar-component>

    <div class="reference-utility-bar__localization mobile:hidden">
      {% if show_language %}
        <div class="reference-utility-bar__locale">
          <span class="reference-utility-bar__locale-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 20 20" fill="none">
              <circle cx="10" cy="10" r="7.25" stroke="currentColor" stroke-width="1.25"/>
              <path d="M3 10h14M10 3c2.2 2.4 2.2 11.6 0 14M10 3c-2.2 2.4-2.2 11.6 0 14" stroke="currentColor" stroke-width="1.25"/>
            </svg>
          </span>
          {% render 'localization-form',
            show_country: false,
            show_language: true,
            localization_style: 'dropdown',
            form_id: lang_form_id
          %}
        </div>
      {% endif %}

      {% if show_country %}
        <dropdown-localization-component class="reference-utility-bar__locale reference-utility-bar__locale--country">
          <button
            type="button"
            class="button dropdown-localization__button localization-selector reference-utility-bar__locale-button"
            aria-expanded="false"
            aria-controls="dropdown-localization-results-{{ section.id }}"
            ref="button"
            on:click="/toggleSelector"
          >
            {% if section.settings.country_selector_style %}
              <span
                class="icon-flag"
                style="background-image: url({{- localization.country | image_url: width: 32 -}});"
              ></span>
            {% endif %}
            <span>
              {{ localization.country.name }}
              ({{ localization.country.currency.iso_code }}
              {{ localization.country.currency.symbol }})
            </span>
            <span class="svg-wrapper icon-caret">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>

          <div
            class="localization-wrapper right-bound color-custom-popover"
            hidden
            ref="panel"
            id="dropdown-localization-results-{{ section.id }}"
          >
            {% render 'localization-form',
              show_country: true,
              show_language: false,
              localization_style: 'dropdown',
              form_id: country_form_id
            %}
          </div>
        </dropdown-localization-component>
      {% endif %}
    </div>
  </div>
</aside>

{% if section.settings.show_floating_rail %}
  <div
    class="reference-floating-rail{% if section.settings.hide_rail_on_mobile %} mobile:hidden{% endif %}"
    style="
      --rail-bg: {{ section.settings.rail_background }};
      --rail-fg: {{ section.settings.rail_text_color }};
      --rail-top: {{ section.settings.rail_offset_top }}px;
    "
  >
    <div class="reference-floating-rail__social">
      {% for platform in social_platforms %}
        {% liquid
          assign url_key = platform | append: '_url'
          assign link_url = section.settings[url_key]
        %}
        {% if link_url != blank %}
          <a
            class="reference-floating-rail__link"
            href="{{ link_url }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ platform | capitalize }}"
          >
            <svg
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              width="18"
              height="18"
            >
              {%- render 'icon', icon: platform -%}
            </svg>
          </a>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.discount_text != blank %}
      {% if section.settings.discount_link != blank %}
        <a class="reference-floating-rail__discount" href="{{ section.settings.discount_link }}">
          {{ section.settings.discount_text }}
        </a>
      {% else %}
        <span class="reference-floating-rail__discount">
          {{ section.settings.discount_text }}
        </span>
      {% endif %}
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .reference-utility-bar {
    --color-foreground: var(--utility-fg);
    --color-foreground-rgb: 255 255 255;
    --utility-bar-height: 56px;
    background: var(--utility-bg);
    color: var(--utility-fg);
    position: relative;
    z-index: var(--layer-heightened);
    border-radius: 0;
  }

  .reference-utility-bar__inner {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 0.75rem;
    box-sizing: border-box;
    height: var(--utility-bar-height);
    min-height: var(--utility-bar-height);
    padding-block: var(--utility-padding-block, 18px);
    padding-inline: var(--page-margin);
  }

  @media screen and (min-width: 750px) {
    .reference-utility-bar__inner {
      grid-template-columns: minmax(8rem, 1fr) minmax(0, 2fr) minmax(8rem, 1fr);
    }
  }

  .reference-utility-bar__social {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .reference-utility-bar__social-link {
    display: inline-flex;
    color: inherit;
    opacity: 0.95;
  }

  .reference-utility-bar__social-link:hover {
    opacity: 0.7;
  }

  .reference-utility-bar__social-icon {
    display: block;
    fill: currentColor;
  }

  .reference-utility-bar__announcements {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;
    justify-content: center;
    min-width: 0;
  }

  .reference-utility-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size, 2.5rem) * 2);
    max-width: 36rem;
    margin-inline: auto;
  }

  .reference-utility-bar__slides > * {
    grid-area: stack;
  }

  .reference-utility-bar .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
  }

  .reference-utility-bar .announcement-bar__slide[aria-hidden='true'] {
    opacity: 0;
    visibility: hidden;
  }

  .reference-utility-bar .announcement-bar__text {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .reference-utility-bar__announcements slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .reference-utility-bar__announcements .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size, 2rem);
    height: var(--button-size, 2rem);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;
    color: var(--utility-fg);
  }

  .reference-utility-bar__announcements .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs, 0.75rem);
    height: var(--icon-size-xs, 0.75rem);
  }

  .reference-utility-bar__localization {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    font-size: 0.75rem;
  }

  .reference-utility-bar__locale {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .reference-utility-bar__locale-icon {
    display: inline-flex;
    color: inherit;
  }

  .reference-utility-bar__locale-button,
  .reference-utility-bar .dropdown-localization__button,
  .reference-utility-bar .language-selector {
    color: var(--utility-fg);
    font-size: 0.75rem;
    background: transparent;
    border: none;
    box-shadow: none;
    padding-inline: 0;
  }

  .reference-utility-bar .dropdown-localization__button:hover,
  .reference-utility-bar__locale-button:hover {
    background: transparent;
    border-color: transparent;
    opacity: 0.8;
  }

  .reference-utility-bar .icon-flag {
    width: 0.9rem;
    height: 0.9rem;
    clip-path: circle(50%);
    background-position: center;
    background-size: cover;
    margin-inline-end: 0.25rem;
  }

  .reference-utility-bar .svg-wrapper.icon-caret {
    width: 0.65rem;
    height: 0.65rem;
  }

  .reference-utility-bar .language-selector {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    position: relative;
  }

  .reference-utility-bar .localization-form__select {
    appearance: none;
    background: transparent;
    border: none;
    color: inherit;
    font-size: 0.75rem;
    padding-inline-end: 1rem;
    cursor: pointer;
  }

  .reference-utility-bar .language-selector .icon-caret {
    position: absolute;
    right: 0;
    pointer-events: none;
  }

  .reference-utility-bar dropdown-localization-component {
    position: relative;
  }

  .reference-utility-bar .localization-wrapper {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: calc(var(--layer-header-menu, 20) + 1);
    box-shadow: var(--shadow-popover, 0 8px 24px rgb(0 0 0 / 12%));
    border: var(--style-border-popover, 1px solid rgb(0 0 0 / 8%));
    background-color: var(--color-background, #fff);
    border-radius: var(--style-border-radius-popover, 0.5rem);
    max-height: 27.5rem;
    overflow: auto;
  }

  .reference-utility-bar .localization-wrapper.right-bound {
    right: 0;
    left: unset;
  }

  .reference-floating-rail {
    position: fixed;
    left: max(0.5rem, calc(var(--homepage-gutter, 12px) - 0.15rem));
    top: calc(var(--header-height, 96px) + var(--rail-top, 3.5rem));
    z-index: calc(var(--layer-menu-drawer, 12) - 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1.35rem;
    width: 3.25rem;
    min-height: 16rem;
    padding: 1.15rem 0.65rem;
    border-radius: 999px;
    background: var(--rail-bg);
    color: var(--rail-fg);
    box-shadow: 0 8px 24px rgb(0 0 0 / 12%);
  }

  .reference-floating-rail__social {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.95rem;
  }

  .reference-floating-rail__link {
    display: inline-flex;
    color: inherit;
    opacity: 0.95;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .reference-floating-rail__link:hover,
  .reference-floating-rail__link:focus-visible {
    opacity: 0.7;
    transform: scale(1.08);
  }

  .reference-floating-rail__link svg {
    fill: currentColor;
  }

  .reference-floating-rail__discount {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    text-decoration: none;
    color: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 160ms ease;
  }

  .reference-floating-rail__discount:hover,
  .reference-floating-rail__discount:focus-visible {
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Utility bar",
  "tag": "section",
  "class": "reference-utility-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Announcements"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X / Twitter"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube"
    },
    {
      "type": "header",
      "content": "Localization"
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "Show language selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "Show country / currency selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "country_selector_style",
      "label": "Show country flag",
      "default": true,
      "visible_if": "{{ section.settings.show_country }}"
    },
    {
      "type": "header",
      "content": "Floating social rail"
    },
    {
      "type": "checkbox",
      "id": "show_floating_rail",
      "label": "Show floating rail",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_rail_on_mobile",
      "label": "Hide rail on mobile",
      "default": true,
      "visible_if": "{{ section.settings.show_floating_rail }}"
    },
    {
      "type": "text",
      "id": "discount_text",
      "label": "Discount text",
      "default": "GET 20% OFF"
    },
    {
      "type": "url",
      "id": "discount_link",
      "label": "Discount link",
      "visible_if": "{{ section.settings.show_floating_rail }}"
    },
    {
      "type": "range",
      "id": "rail_offset_top",
      "label": "Rail top offset",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.show_floating_rail }}"
    },
    {
      "type": "color",
      "id": "rail_background",
      "label": "Rail background",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.show_floating_rail }}"
    },
    {
      "type": "color",
      "id": "rail_text_color",
      "label": "Rail text / icons",
      "default": "#111111",
      "visible_if": "{{ section.settings.show_floating_rail }}"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding",
      "min": 4,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Utility bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement",
          "settings": {
            "text": "A question? Visit our contact page",
            "font_size": "0.75rem"
          }
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
