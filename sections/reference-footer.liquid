{% liquid
  assign collections_menu = section.settings.collections_menu
  assign information_menu = section.settings.information_menu
  assign social_platforms = 'facebook,twitter,instagram,youtube' | split: ','
%}

<footer
  class="reference-footer"
  style="
    --rf-radius: {{ section.settings.corner_radius }}px;
    --rf-light-bg: {{ section.settings.features_background }};
    --rf-light-fg: {{ section.settings.features_text_color }};
    --rf-dark-bg: {{ section.settings.background }};
    --rf-dark-fg: {{ section.settings.text_color }};
    --rf-input-bg: {{ section.settings.input_background }};
  "
  {{ section.shopify_attributes }}
>
  <div class="rf-features">
    {% for index in (1..4) %}
      {% liquid
        assign title_key = 'feature_' | append: index | append: '_title'
        assign text_key = 'feature_' | append: index | append: '_text'
        assign title = section.settings[title_key]
        assign text = section.settings[text_key]
      %}
      <div class="rf-feature">
        <span class="rf-feature__icon" aria-hidden="true">
          {% case index %}
            {% when 1 %}
              <svg viewBox="0 0 24 24"><path d="M4 13v-2a8 8 0 0 1 16 0v2M4 13h3v7H5a1 1 0 0 1-1-1v-6Zm16 0h-3v7h2a1 1 0 0 0 1-1v-6Z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
            {% when 2 %}
              <svg viewBox="0 0 24 24"><path d="m4 8 8-4 8 4-8 4-8-4Zm0 0v8l8 4 8-4V8M12 12v8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
            {% when 3 %}
              <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3 19v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2M16 5a3 3 0 0 1 0 6M17 13a4 4 0 0 1 4 4v2" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
            {% else %}
              <svg viewBox="0 0 24 24"><path d="m12 3 7 3v5c0 4.8-2.8 8.2-7 10-4.2-1.8-7-5.2-7-10V6l7-3Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m9 12 2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          {% endcase %}
        </span>
        <div>
          <h2 class="rf-feature__title">{{ title }}</h2>
          <p class="rf-feature__text">{{ text }}</p>
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="rf-main">
    <div class="rf-main__left">
      <div class="rf-brand">
        {% if settings.logo_inverse != blank %}
          {{
            settings.logo_inverse
            | image_url: width: 240
            | image_tag: widths: '120, 180, 240', sizes: '100px', class: 'rf-brand__image', alt: shop.name
          }}
        {% elsif settings.logo != blank %}
          {{
            settings.logo
            | image_url: width: 240
            | image_tag: widths: '120, 180, 240', sizes: '100px', class: 'rf-brand__image', alt: shop.name
          }}
        {% else %}
          <span class="rf-brand__text">{{ shop.name }}</span>
        {% endif %}
      </div>

      <div class="rf-column">
        <h2 class="rf-column__title">{{ section.settings.collections_heading }}</h2>
        {% if collections_menu != blank %}
          <ul class="rf-menu" role="list">
            {% for link in collections_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        {% else %}
          <ul class="rf-menu" role="list">
            <li><a href="{{ routes.all_products_collection_url }}">Headphones</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">Earphones</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">Speakers</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">Accessories</a></li>
          </ul>
        {% endif %}

        <div class="rf-contact">
          {% if section.settings.phone != blank %}
            <a href="tel:{{ section.settings.phone | replace: ' ', '' }}">{{ section.settings.phone }}</a>
          {% endif %}
          {% if section.settings.email != blank %}
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          {% endif %}
        </div>
      </div>

      <div class="rf-column">
        <h2 class="rf-column__title">{{ section.settings.information_heading }}</h2>
        {% if information_menu != blank %}
          <ul class="rf-menu" role="list">
            {% for link in information_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        {% else %}
          <ul class="rf-menu" role="list">
            <li><a href="/pages/about-us">Our Story</a></li>
            <li><a href="/blogs/news">Our Journal</a></li>
            <li><a href="/pages/faq">FAQs</a></li>
            <li><a href="/pages/contact">Contact Us</a></li>
          </ul>
        {% endif %}
      </div>
    </div>

    <div class="rf-newsletter">
      <h2 class="rf-newsletter__heading">{{ section.settings.newsletter_heading | newline_to_br }}</h2>

      {% form 'customer', class: 'rf-newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="ReferenceFooterEmail-{{ section.id }}">Email address</label>
        <input
          id="ReferenceFooterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ section.settings.email_placeholder }}"
          autocomplete="email"
          required
        >
        <button type="submit" aria-label="Subscribe">
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </button>
        {% if form.posted_successfully? %}
          <p class="rf-newsletter__message">Thanks for subscribing.</p>
        {% elsif form.errors %}
          <p class="rf-newsletter__message">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {% endif %}
      {% endform %}

      <div class="rf-socials">
        {% for platform in social_platforms %}
          {% liquid
            assign url_key = platform | append: '_url'
            assign social_url = section.settings[url_key]
          %}
          {% if social_url != blank %}
            <a href="{{ social_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ platform | capitalize }}">
              <svg viewBox="0 0 20 20" aria-hidden="true">
                {% render 'icon', icon: platform %}
              </svg>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="rf-bottom">
    <p class="rf-copyright">
      © {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.copyright_suffix != blank %}, {{ section.settings.copyright_suffix }}{% endif %}
    </p>

    <div class="rf-localization">
      {% if localization.available_languages.size > 1 or localization.available_countries.size > 1 %}
        {% render 'localization-form',
          show_country: true,
          show_language: true,
          localization_style: 'dropdown',
          form_id: section.id
        %}
      {% endif %}
    </div>

    {% if shop.enabled_payment_types.size > 0 %}
      <div class="rf-payments" aria-label="Payment methods">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag: class: 'rf-payment-icon' }}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .reference-footer {
    display: block;
    color: var(--rf-dark-fg, #ffffff);
    background: var(--rf-dark-bg, #1c1c1c);
  }

  .rf-features {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    padding: clamp(1.5rem, 3.5vw, 2.75rem) clamp(1rem, 3vw, 2rem);
    border-radius: 0 0 var(--rf-radius, 17px) var(--rf-radius, 17px);
    background: var(--rf-light-bg, #ffffff);
    color: var(--rf-light-fg, #111111);
  }

  .rf-feature {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    gap: 0.85rem;
    padding-inline: clamp(0.5rem, 2vw, 1.5rem);
    border-right: 1px solid rgb(0 0 0 / 8%);
  }

  .rf-feature:last-child {
    border-right: 0;
  }

  .rf-feature__icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .rf-feature__title,
  .rf-feature__text {
    margin: 0;
  }

  .rf-feature__title {
    font-size: 0.95rem;
    line-height: 1.25;
    font-weight: 500;
  }

  .rf-feature__text {
    margin-top: 0.35rem;
    max-width: 30ch;
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .rf-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 18rem;
  }

  .rf-main__left {
    display: grid;
    grid-template-columns: minmax(4rem, 0.5fr) 1fr 1fr;
    gap: clamp(1rem, 3vw, 3.5rem);
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.5rem, 5vw, 4rem);
  }

  .rf-brand__image {
    display: block;
    width: min(100%, 6rem);
    height: auto;
    filter: brightness(0) invert(1);
  }

  .rf-brand__text {
    font-size: 1.2rem;
    font-weight: 700;
  }

  .rf-column__title {
    margin: 0 0 1rem;
    color: inherit;
    font-size: 1rem;
    font-weight: 700;
  }

  .rf-menu {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rf-menu a,
  .rf-contact a {
    color: inherit;
    text-decoration: none;
    font-size: 0.85rem;
  }

  .rf-menu a:hover,
  .rf-contact a:hover {
    text-decoration: underline;
  }

  .rf-contact {
    display: grid;
    gap: 0.15rem;
    margin-top: 2.5rem;
  }

  .rf-contact a {
    width: fit-content;
    font-size: 1.05rem;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .rf-newsletter {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.75rem;
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.5rem, 8vw, 6rem);
    border-left: 1px solid rgb(255 255 255 / 7%);
  }

  .rf-newsletter__heading {
    margin: 0;
    max-width: 18ch;
    color: inherit;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.03;
    letter-spacing: -0.03em;
  }

  .rf-newsletter__form {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    width: min(100%, 28rem);
    border-radius: 0.2rem;
    background: var(--rf-input-bg, #272727);
  }

  .rf-newsletter__form input {
    min-width: 0;
    padding: 1rem 1.15rem;
    border: 0;
    outline: 0;
    background: transparent;
    color: inherit;
  }

  .rf-newsletter__form button {
    display: grid;
    place-items: center;
    align-self: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-right: 0.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #ffffff;
    color: #111111;
    cursor: pointer;
  }

  .rf-newsletter__form button svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .rf-newsletter__message {
    grid-column: 1 / -1;
    margin: 0;
    padding: 0 1rem 0.75rem;
    font-size: 0.75rem;
  }

  .rf-socials {
    display: flex;
    gap: 1.25rem;
    margin-top: auto;
  }

  .rf-socials a {
    color: inherit;
  }

  .rf-socials svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .rf-bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid rgb(255 255 255 / 6%);
    background: #151515;
    font-size: 0.72rem;
  }

  .rf-copyright {
    margin: 0;
    opacity: 0.8;
  }

  .rf-localization {
    justify-self: center;
  }

  .rf-localization .localization-form__select,
  .rf-localization button {
    color: inherit;
  }

  .rf-payments {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .rf-payment-icon {
    width: 2rem;
    height: auto;
  }

  @media screen and (max-width: 989px) {
    .rf-features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1.5rem;
    }

    .rf-feature:nth-child(2) {
      border-right: 0;
    }

    .rf-main {
      grid-template-columns: 1fr;
    }

    .rf-newsletter {
      border-left: 0;
      border-top: 1px solid rgb(255 255 255 / 7%);
    }
  }

  @media screen and (max-width: 749px) {
    .rf-features {
      grid-template-columns: 1fr;
    }

    .rf-feature {
      border-right: 0;
    }

    .rf-main__left {
      grid-template-columns: 1fr 1fr;
    }

    .rf-brand {
      grid-column: 1 / -1;
    }

    .rf-bottom {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .rf-localization,
    .rf-payments {
      justify-self: center;
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reference footer",
  "tag": "section",
  "class": "reference-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Service features"
    },
    {
      "type": "text",
      "id": "feature_1_title",
      "label": "Feature 1 title",
      "default": "Customer service"
    },
    {
      "type": "textarea",
      "id": "feature_1_text",
      "label": "Feature 1 text",
      "default": "It's not actually free, we just price it into the products."
    },
    {
      "type": "text",
      "id": "feature_2_title",
      "label": "Feature 2 title",
      "default": "Fast Free Shipping"
    },
    {
      "type": "textarea",
      "id": "feature_2_text",
      "label": "Feature 2 text",
      "default": "Get free shipping on orders of $150 or more"
    },
    {
      "type": "text",
      "id": "feature_3_title",
      "label": "Feature 3 title",
      "default": "Refer a friend"
    },
    {
      "type": "textarea",
      "id": "feature_3_text",
      "label": "Feature 3 text",
      "default": "Refer a friend and get 15% off each other."
    },
    {
      "type": "text",
      "id": "feature_4_title",
      "label": "Feature 4 title",
      "default": "Secure payment"
    },
    {
      "type": "textarea",
      "id": "feature_4_text",
      "label": "Feature 4 text",
      "default": "Your payment information is processed securely"
    },
    {
      "type": "header",
      "content": "Links and contact"
    },
    {
      "type": "text",
      "id": "collections_heading",
      "label": "Collections heading",
      "default": "Collections"
    },
    {
      "type": "link_list",
      "id": "collections_menu",
      "label": "Collections menu"
    },
    {
      "type": "text",
      "id": "information_heading",
      "label": "Information heading",
      "default": "Information"
    },
    {
      "type": "link_list",
      "id": "information_menu",
      "label": "Information menu"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+21 (0) 987 6543 21"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hello@domain.com"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "textarea",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Stay in the loop with our weekly newsletter"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X / Twitter URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Feature strip bottom radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "color",
      "id": "features_background",
      "label": "Feature strip background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "features_text_color",
      "label": "Feature strip text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Footer background",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Footer text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Email input background",
      "default": "#272727"
    },
    {
      "type": "text",
      "id": "copyright_suffix",
      "label": "Copyright suffix",
      "default": "Powered by Shopify"
    }
  ],
  "presets": [
    {
      "name": "Reference footer",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
