{% liquid
  assign heading = section.settings.heading
  assign body = section.settings.body
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign parallax_strength = section.settings.parallax_strength | default: 20
  assign section_anchor = 'ProductStoryHighlights'

  if cta_link == blank
    assign cta_link = '#ProductFeatures'
  endif
%}

<script
  src="{{ 'product-story-highlights.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<product-story-highlights
  id="{{ section_anchor }}"
  class="product-story-highlights section spacing-style"
  data-parallax-strength="{{ parallax_strength }}"
  style="
    --psh-radius: {{ section.settings.card_radius }}px;
    --psh-gap: {{ section.settings.column_gap }}px;
    --psh-bg: {{ section.settings.background_color }};
    {% render 'spacing-style', settings: section.settings %}
  "
  {{ section.shopify_attributes }}
>
  <div class="product-story-highlights__grid">
    <div class="product-story-highlights__copy">
      {% if heading != blank %}
        <h2 class="product-story-highlights__heading">{{ heading }}</h2>
      {% endif %}

      {% if body != blank %}
        <div class="product-story-highlights__body rte">{{ body }}</div>
      {% endif %}

      {% if cta_label != blank %}
        <a class="product-story-highlights__cta" href="{{ cta_link }}">
          <span>{{ cta_label | escape }}</span>
          <span class="product-story-highlights__cta-icon" aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>

    <div class="product-story-highlights__center" ref="centerColumn">
      {% for block in section.blocks %}
        {% if block.type != 'center_card' %}{% continue %}{% endif %}
        {% liquid
          assign card_image = block.settings.image
          assign text_position = block.settings.text_position | default: 'bottom-left'
          assign card_alt = block.settings.title
          if card_image != blank and card_image.alt != blank
            assign card_alt = card_image.alt
          endif
        %}
        <article
          class="product-story-highlights__card product-story-highlights__card--{{ text_position }}"
          {{ block.shopify_attributes }}
        >
          <div class="product-story-highlights__card-media">
            {% if card_image != blank %}
              {{
                card_image
                | image_url: width: 1200
                | image_tag:
                  class: 'product-story-highlights__card-image',
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '(min-width: 990px) 28vw, 90vw',
                  loading: 'lazy',
                  alt: card_alt
              }}
            {% else %}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'product-story-highlights__card-placeholder' }}
            {% endif %}
          </div>
          {% if block.settings.eyebrow != blank or block.settings.title != blank %}
            <div class="product-story-highlights__card-copy">
              {% if block.settings.eyebrow != blank %}
                <p class="product-story-highlights__card-eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {% endif %}
              {% if block.settings.title != blank %}
                <p class="product-story-highlights__card-title">{{ block.settings.title | escape }}</p>
              {% endif %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>

    <div class="product-story-highlights__right">
      {% for block in section.blocks %}
        {% if block.type != 'right_card' %}{% continue %}{% endif %}
        {% liquid
          assign card_image = block.settings.image
          assign text_position = block.settings.text_position | default: 'top-right'
          assign card_alt = block.settings.title
          if card_image != blank and card_image.alt != blank
            assign card_alt = card_image.alt
          endif
        %}
        <article
          class="product-story-highlights__card product-story-highlights__card--{{ text_position }}"
          {{ block.shopify_attributes }}
        >
          <div class="product-story-highlights__card-media">
            {% if card_image != blank %}
              {{
                card_image
                | image_url: width: 1200
                | image_tag:
                  class: 'product-story-highlights__card-image',
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '(min-width: 990px) 28vw, 90vw',
                  loading: 'lazy',
                  alt: card_alt
              }}
            {% else %}
              {{ 'product-apparel-2' | placeholder_svg_tag: 'product-story-highlights__card-placeholder' }}
            {% endif %}
          </div>
          {% if block.settings.eyebrow != blank or block.settings.title != blank %}
            <div class="product-story-highlights__card-copy">
              {% if block.settings.eyebrow != blank %}
                <p class="product-story-highlights__card-eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {% endif %}
              {% if block.settings.title != blank %}
                <p class="product-story-highlights__card-title">{{ block.settings.title | escape }}</p>
              {% endif %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</product-story-highlights>

{% stylesheet %}
  .product-story-highlights {
    display: block;
    background: var(--psh-bg, #ffffff);
    color: #111111;
  }

  .product-story-highlights__grid {
    display: grid;
    gap: var(--psh-gap, 1.25rem);
    align-items: start;
  }

  .product-story-highlights__copy {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    max-width: 28rem;
  }

  .product-story-highlights__heading {
    margin: 0;
    font-size: clamp(2rem, 3.4vw, 3.1rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 800;
    text-transform: uppercase;
  }

  .product-story-highlights__body {
    font-size: 1rem;
    line-height: 1.55;
    color: rgb(17 17 17 / 78%);
  }

  .product-story-highlights__body > *:first-child {
    margin-block-start: 0;
  }

  .product-story-highlights__body > *:last-child {
    margin-block-end: 0;
  }

  .product-story-highlights__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    width: fit-content;
    margin-top: 0.35rem;
    padding: 0.75rem 1.2rem;
    border: 1px solid #111111;
    border-radius: 999px;
    background: #ffffff;
    color: #111111;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 650;
  }

  .product-story-highlights__cta:hover {
    background: #111111;
    color: #ffffff;
  }

  .product-story-highlights__cta-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .product-story-highlights__center,
  .product-story-highlights__right {
    display: flex;
    flex-direction: column;
    gap: var(--psh-gap, 1.25rem);
  }

  .product-story-highlights__center {
    will-change: transform;
  }

  .product-story-highlights__card {
    position: relative;
    overflow: hidden;
    border-radius: var(--psh-radius, 24px);
    background: #f3f3f3;
    isolation: isolate;
  }

  .product-story-highlights__card-media {
    aspect-ratio: 4 / 5;
    min-height: 16rem;
  }

  .product-story-highlights__center .product-story-highlights__card:first-child .product-story-highlights__card-media {
    aspect-ratio: 4 / 4.4;
  }

  .product-story-highlights__right .product-story-highlights__card:first-child .product-story-highlights__card-media {
    aspect-ratio: 4 / 5.2;
    min-height: 20rem;
  }

  .product-story-highlights__card-image,
  .product-story-highlights__card-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-story-highlights__card-copy {
    position: absolute;
    z-index: 1;
    max-width: min(90%, 16rem);
    padding: 1rem 1.1rem;
    color: #ffffff;
    text-shadow: 0 1px 10px rgb(0 0 0 / 35%);
  }

  .product-story-highlights__card--bottom-left .product-story-highlights__card-copy {
    left: 0.35rem;
    bottom: 0.35rem;
  }

  .product-story-highlights__card--bottom-right .product-story-highlights__card-copy {
    right: 0.35rem;
    bottom: 0.35rem;
    text-align: right;
  }

  .product-story-highlights__card--top-left .product-story-highlights__card-copy {
    left: 0.35rem;
    top: 0.35rem;
  }

  .product-story-highlights__card--top-right .product-story-highlights__card-copy {
    right: 0.35rem;
    top: 0.35rem;
    text-align: right;
  }

  .product-story-highlights__card-eyebrow {
    margin: 0 0 0.2rem;
    font-size: 0.78rem;
    opacity: 0.9;
  }

  .product-story-highlights__card-title {
    margin: 0;
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    line-height: 1.2;
    font-weight: 650;
  }

  @media screen and (min-width: 990px) {
    .product-story-highlights__grid {
      grid-template-columns: minmax(14rem, 0.9fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--psh-gap, 1.25rem);
      align-items: center;
    }

    .product-story-highlights__copy {
      position: static;
      top: auto;
      padding-block: 0;
    }

    .product-story-highlights__center {
      padding-top: 0;
    }

    .product-story-highlights__right {
      padding-top: 2.5rem;
    }
  }

  @media screen and (max-width: 989px) {
    .product-story-highlights__copy {
      max-width: none;
      order: 1;
    }

    .product-story-highlights__center {
      order: 2;
    }

    .product-story-highlights__right {
      order: 3;
    }

    .product-story-highlights__center,
    .product-story-highlights__right {
      transform: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-story-highlights__center {
      transform: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product story highlights",
  "tag": "section",
  "class": "product-story-highlights-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Symphony of Superior Sound."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Dive into a world of pristine audio clarity where every note lands with depth, precision, and presence.</p><p>Crafted for long listening sessions with materials that stay soft, stable, and timeless.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "View Tech Spec"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "parallax_strength",
      "label": "Center column parallax (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left padding",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right padding",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "center_card",
      "name": "Center card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Pure Silence"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Active Noise Cancellation"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "options": [
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-right", "label": "Bottom right" },
            { "value": "top-left", "label": "Top left" },
            { "value": "top-right", "label": "Top right" }
          ],
          "default": "bottom-left"
        }
      ]
    },
    {
      "type": "right_card",
      "name": "Right card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Timeless design, made to last for generations."
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "options": [
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-right", "label": "Bottom right" },
            { "value": "top-left", "label": "Top left" },
            { "value": "top-right", "label": "Top right" }
          ],
          "default": "top-right"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product story highlights",
      "category": "Product",
      "blocks": [
        {
          "type": "center_card",
          "settings": {
            "eyebrow": "Pure Silence",
            "title": "Active Noise Cancellation",
            "text_position": "bottom-left"
          }
        },
        {
          "type": "center_card",
          "settings": {
            "eyebrow": "Complete Elegance",
            "title": "Vast Accessory Selection",
            "text_position": "bottom-left"
          }
        },
        {
          "type": "right_card",
          "settings": {
            "eyebrow": "New comfort zone",
            "title": "Timeless design, made to last for generations.",
            "text_position": "top-right"
          }
        },
        {
          "type": "right_card",
          "settings": {
            "eyebrow": "Up to 30h Battery Life",
            "title": "with active Bluetooth and Active Noise Cancellation",
            "text_position": "bottom-right"
          }
        }
      ]
    }
  ]
}
{% endschema %}
