<script
  src="{{ 'marquee.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign gap_between_elements = section.settings.gap_between_elements
  assign hover_pause = section.settings.hover_pause

  case section.settings.speed_factor
    when 'slow'
      assign speed_factor = 36
    when 'fast'
      assign speed_factor = 16
    else
      assign speed_factor = 25
  endcase
%}

{% capture logo_items %}
  {% if section.blocks.size > 0 %}
    {% for block in section.blocks %}
      <div
        class="dlm__logo"
        style="--dlm-logo-width: {{ block.settings.logo_width }}px;"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          {{
            block.settings.image
            | image_url: width: 600
            | image_tag:
              widths: '120, 200, 300, 400, 600',
              sizes: '140px',
              class: 'dlm__logo-image',
              loading: 'lazy',
              alt: block.settings.alt
          }}
        {% elsif block.settings.label != blank %}
          <span class="dlm__logo-text">{{ block.settings.label | escape }}</span>
        {% else %}
          <span class="dlm__logo-text">Brand</span>
        {% endif %}
      </div>
    {% endfor %}
  {% else %}
    {% assign placeholders = 'Apple,Bowers & Wilkins,urbanista,B&O,BOSE,Master & Dynamic,logitech' | split: ',' %}
    {% for name in placeholders %}
      <div class="dlm__logo" style="--dlm-logo-width: 140px;">
        <span class="dlm__logo-text">{{ name }}</span>
      </div>
    {% endfor %}
  {% endif %}
{% endcapture %}

<div
  class="diagonal-logo-marquees hp-inner-pad"
  style="
    --dlm-angle: {{ section.settings.angle }}deg;
    --dlm-row-height: {{ section.settings.row_height }}px;
    --dlm-primary-bg: {{ section.settings.primary_background }};
    --dlm-secondary-bg: {{ section.settings.secondary_background }};
    --dlm-primary-fg: {{ section.settings.primary_text_color }};
    --dlm-secondary-fg: {{ section.settings.secondary_text_color }};
    --dlm-secondary-opacity: {{ section.settings.secondary_opacity | times: 0.01 }};
    --hp-pad-x-mobile: 0px;
    --hp-pad-x-desktop: 0px;
    {% render 'spacing-padding', settings: section.settings %}
  "
>
  <div class="dlm">
    <div class="dlm__row dlm__row--primary">
      <marquee-component
        class="dlm__marquee"
        style="{% render 'gap-style', value: gap_between_elements, name: 'marquee-gap' %}"
        data-speed-factor="{{ speed_factor }}"
        data-movement-direction="normal"
        data-scroll-reactive="true"
        data-idle-rate="{{ section.settings.idle_rate | times: 0.01 }}"
        data-scroll-boost="{{ section.settings.scroll_boost }}"
        data-max-boost="{{ section.settings.max_boost | times: 0.1 }}"
        data-hover-pause="{% if hover_pause %}true{% else %}false{% endif %}"
      >
        <div class="marquee__wrapper" ref="wrapper">
          <div class="marquee__content" ref="content">
            <div class="marquee__repeated-items" ref="marqueeItems[]">
              {{ logo_items }}
            </div>
          </div>
        </div>
      </marquee-component>
    </div>

    <div class="dlm__row dlm__row--secondary">
      <marquee-component
        class="dlm__marquee"
        style="{% render 'gap-style', value: gap_between_elements, name: 'marquee-gap' %}"
        data-speed-factor="{{ speed_factor }}"
        data-movement-direction="reverse"
        data-scroll-reactive="true"
        data-idle-rate="{{ section.settings.idle_rate | times: 0.01 }}"
        data-scroll-boost="{{ section.settings.scroll_boost }}"
        data-max-boost="{{ section.settings.max_boost | times: 0.1 }}"
        data-hover-pause="{% if hover_pause %}true{% else %}false{% endif %}"
      >
        <div class="marquee__wrapper" ref="wrapper">
          <div class="marquee__content" ref="content">
            <div class="marquee__repeated-items" ref="marqueeItems[]">
              {{ logo_items }}
            </div>
          </div>
        </div>
      </marquee-component>
    </div>
  </div>
</div>

{% stylesheet %}
  /* Outside: X 0 (edge-to-edge). Inside: X 0. Y via theme editor. */
  .diagonal-logo-marquees-section {
    --hp-shell-pad-x-mobile: 0px;
    --hp-shell-pad-x-desktop: 0px;
  }

  .diagonal-logo-marquees {
    display: block;
    overflow: hidden;
    background: #ffffff;
    border-radius: 17px 17px 0 0;
  }

  .dlm {
    position: relative;
    min-height: clamp(16rem, 32vw, 24rem);
    overflow: hidden;
  }

  .dlm__row {
    position: absolute;
    left: -22%;
    width: 144%;
    height: var(--dlm-row-height, 104px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .dlm__row--primary {
    top: 40%;
    z-index: 2;
    background: var(--dlm-primary-bg, #f4e7a5);
    color: var(--dlm-primary-fg, #111111);
    transform: translateY(-50%) rotate(calc(var(--dlm-angle, 6deg) * -1));
  }

  .dlm__row--secondary {
    top: 60%;
    z-index: 1;
    background: var(--dlm-secondary-bg, #f1f1f1);
    color: var(--dlm-secondary-fg, #bdbdbd);
    opacity: var(--dlm-secondary-opacity, 0.9);
    transform: translateY(-50%) rotate(var(--dlm-angle, 6deg));
  }

  .dlm__marquee {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .dlm__marquee .marquee__wrapper {
    display: flex;
    gap: var(--marquee-gap);
    width: fit-content;
    white-space: nowrap;
    will-change: transform;
  }

  .dlm__marquee .marquee__content,
  .dlm__marquee .marquee__repeated-items {
    min-width: max-content;
    display: flex;
    align-items: center;
    gap: var(--marquee-gap);
  }

  .dlm__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--dlm-logo-width, 140px);
    height: calc(var(--dlm-row-height, 104px) * 0.48);
    flex: 0 0 auto;
  }

  .dlm__logo-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .dlm__logo-text {
    font-size: clamp(1.05rem, 2vw, 1.55rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
    color: currentColor;
  }

  .dlm__row--secondary .dlm__logo-image {
    opacity: 0.5;
    filter: grayscale(1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .dlm__marquee:not([data-disabled]):not([data-reactive]) .marquee__wrapper {
      animation: dlm-marquee-motion var(--marquee-speed) linear infinite;
    }

    .dlm__marquee[data-reactive] .marquee__wrapper {
      animation: none;
    }
  }

  @keyframes dlm-marquee-motion {
    to {
      transform: translate3d(calc(-50% - (var(--marquee-gap) / 2)), 0, 0);
    }
  }

  @media screen and (max-width: 749px) {
    .dlm {
      min-height: 13.5rem;
    }

    .dlm__row {
      left: -40%;
      width: 180%;
    }

    .dlm__logo {
      height: calc(var(--dlm-row-height, 104px) * 0.42);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Diagonal logo marquees",
  "tag": "section",
  "class": "diagonal-logo-marquees-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "brand_logo",
      "name": "Brand logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Fallback text",
          "default": "Brand"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text"
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "Logo width",
          "min": 60,
          "max": 220,
          "step": 2,
          "unit": "px",
          "default": 140
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "angle",
      "label": "Diagonal angle (degrees)",
      "min": 4,
      "max": 18,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "Row height",
      "min": 48,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 104
    },
    {
      "type": "range",
      "id": "gap_between_elements",
      "label": "Logo gap",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "primary_background",
      "label": "Primary row background",
      "default": "#f4e7a5"
    },
    {
      "type": "color",
      "id": "primary_text_color",
      "label": "Primary row text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "secondary_background",
      "label": "Secondary row background",
      "default": "#f1f1f1"
    },
    {
      "type": "color",
      "id": "secondary_text_color",
      "label": "Secondary row text",
      "default": "#bdbdbd"
    },
    {
      "type": "range",
      "id": "secondary_opacity",
      "label": "Secondary row opacity",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "select",
      "id": "speed_factor",
      "label": "Base speed",
      "options": [
        { "value": "slow", "label": "Slow" },
        { "value": "medium", "label": "Medium" },
        { "value": "fast", "label": "Fast" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "idle_rate",
      "label": "Idle speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "range",
      "id": "scroll_boost",
      "label": "Scroll boost",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "max_boost",
      "label": "Max boost",
      "min": 15,
      "max": 50,
      "step": 1,
      "default": 35,
      "info": "Maximum playback multiplier ×0.1"
    },
    {
      "type": "checkbox",
      "id": "hover_pause",
      "label": "Pause on hover when idle",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Diagonal logo marquees",
      "category": "t:categories.text",
      "blocks": [
        { "type": "brand_logo", "settings": { "label": "Apple", "logo_width": 90 } },
        { "type": "brand_logo", "settings": { "label": "Bowers & Wilkins", "logo_width": 170 } },
        { "type": "brand_logo", "settings": { "label": "urbanista", "logo_width": 130 } },
        { "type": "brand_logo", "settings": { "label": "B&O", "logo_width": 90 } },
        { "type": "brand_logo", "settings": { "label": "BOSE", "logo_width": 100 } },
        { "type": "brand_logo", "settings": { "label": "Master & Dynamic", "logo_width": 150 } },
        { "type": "brand_logo", "settings": { "label": "logitech", "logo_width": 120 } }
      ]
    }
  ]
}
{% endschema %}
