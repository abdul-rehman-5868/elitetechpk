{% liquid
  assign product = closest.product
  assign share_url = shop.url | append: product.url
  if product == blank
    assign share_url = shop.url
  endif
  assign share_title = product.title | default: shop.name | url_encode
  assign encoded_url = share_url | url_encode
%}

<div
  class="product-share-row"
  {{ block.shopify_attributes }}
>
  <div class="product-share-row__shares" role="list">
    <span class="product-share-row__label">Share:</span>
    {% if block.settings.show_facebook %}
      <a
        class="product-share-row__link"
        href="https://www.facebook.com/sharer.php?u={{ encoded_url }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on Facebook"
        role="listitem"
      >
        <svg class="product-share-row__icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20">
          {%- render 'icon', icon: 'facebook' -%}
        </svg>
      </a>
    {% endif %}

    {% if block.settings.show_twitter %}
      <a
        class="product-share-row__link"
        href="https://twitter.com/intent/tweet?url={{ encoded_url }}&text={{ share_title }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on X"
        role="listitem"
      >
        <svg class="product-share-row__icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20">
          {%- render 'icon', icon: 'twitter' -%}
        </svg>
      </a>
    {% endif %}

    {% if block.settings.show_pinterest %}
      <a
        class="product-share-row__link"
        href="https://pinterest.com/pin/create/button/?url={{ encoded_url }}&description={{ share_title }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on Pinterest"
        role="listitem"
      >
        <svg class="product-share-row__icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20">
          {%- render 'icon', icon: 'pinterest' -%}
        </svg>
      </a>
    {% endif %}

    {% if block.settings.show_email %}
      <a
        class="product-share-row__link"
        href="mailto:?subject={{ share_title }}&body={{ encoded_url }}"
        aria-label="Share by email"
        role="listitem"
      >
        <svg
          class="product-share-row__icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
          width="18"
          height="18"
        >
          <path
            d="M3.5 5.5h13v9h-13v-9Z"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linejoin="round"
          />
          <path
            d="m3.75 6 6.25 5 6.25-5"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    {% endif %}
  </div>

  {% if block.settings.help_label != blank %}
    {% if block.settings.help_link != blank %}
      <a class="product-share-row__help" href="{{ block.settings.help_link }}">
        <svg class="product-share-row__help-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20">
          {%- render 'icon', icon: 'question_mark' -%}
        </svg>
        <span>{{ block.settings.help_label }}</span>
      </a>
    {% else %}
      <span class="product-share-row__help">
        <svg class="product-share-row__help-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 20 20">
          {%- render 'icon', icon: 'question_mark' -%}
        </svg>
        <span>{{ block.settings.help_label }}</span>
      </span>
    {% endif %}
  {% endif %}
</div>

{% stylesheet %}
  .product-share-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
  }

  .product-share-row__shares {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .product-share-row__label {
    font-size: 0.875rem;
    color: #111111;
  }

  .product-share-row__link {
    display: inline-flex;
    color: #111111;
    text-decoration: none;
  }

  .product-share-row__icon {
    width: 1.1rem;
    height: 1.1rem;
    display: block;
  }

  .product-share-row__help {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #111111;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .product-share-row__help:hover {
    opacity: 0.75;
  }

  .product-share-row__help-icon {
    width: 1rem;
    height: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Share and help",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_facebook",
      "label": "Show Facebook",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_twitter",
      "label": "Show X",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pinterest",
      "label": "Show Pinterest",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Show email",
      "default": true
    },
    {
      "type": "text",
      "id": "help_label",
      "label": "Help label",
      "default": "Need help?"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "Help link"
    }
  ],
  "presets": [
    {
      "name": "Share and help",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
