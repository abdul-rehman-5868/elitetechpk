{% liquid
  assign product = closest.product
  assign processor = product.metafields.custom.processor.value
  assign ram = product.metafields.custom.ram.value
  assign storage = product.metafields.custom.storage.value
  assign display_spec = product.metafields.custom.display.value
  assign battery_life = product.metafields.custom.battery_life.value
  assign weight = product.metafields.custom.weight.value

  assign has_specs = false
  if processor != blank or ram != blank or storage != blank or display_spec != blank or battery_life != blank or weight != blank
    assign has_specs = true
  endif
%}

{% if has_specs %}
  <section
    id="ProductHighlights"
    class="product-meta-highlights"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.heading != blank %}
      <h2 class="product-meta-highlights__heading">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="product-meta-highlights__grid">
      {% if processor != blank %}
        <article class="product-meta-highlights__item">
          <span class="product-meta-highlights__icon" aria-hidden="true"><svg viewBox="0 0 20 20">{% render 'icon', icon: 'lightning_bolt' %}</svg></span>
          <div class="product-meta-highlights__copy">
            <strong>{{ processor }}</strong>
            <small>Processor</small>
          </div>
        </article>
      {% endif %}
      {% if ram != blank %}
        <article class="product-meta-highlights__item">
          <span class="product-meta-highlights__icon" aria-hidden="true"><svg viewBox="0 0 20 20">{% render 'icon', icon: 'box' %}</svg></span>
          <div class="product-meta-highlights__copy">
            <strong>{{ ram }}</strong>
            <small>Memory (RAM)</small>
          </div>
        </article>
      {% endif %}
      {% if storage != blank %}
        <article class="product-meta-highlights__item">
          <span class="product-meta-highlights__icon" aria-hidden="true"><svg viewBox="0 0 20 20">{% render 'icon', icon: 'check_box' %}</svg></span>
          <div class="product-meta-highlights__copy">
            <strong>{{ storage }}</strong>
            <small>Storage</small>
          </div>
        </article>
      {% endif %}
      {% if display_spec != blank %}
        <article class="product-meta-highlights__item">
          <span class="product-meta-highlights__icon" aria-hidden="true"><svg viewBox="0 0 20 20">{% render 'icon', icon: 'eye' %}</svg></span>
          <div class="product-meta-highlights__copy">
            <strong>{{ display_spec }}</strong>
            <small>Display</small>
          </div>
        </article>
      {% endif %}
      {% if battery_life != blank %}
        <article class="product-meta-highlights__item">
          <span class="product-meta-highlights__icon" aria-hidden="true"><svg viewBox="0 0 20 20">{% render 'icon', icon: 'star' %}</svg></span>
          <div class="product-meta-highlights__copy">
            <strong>{{ battery_life }}</strong>
            <small>Battery life</small>
          </div>
        </article>
      {% endif %}
      {% if weight != blank %}
        <article class="product-meta-highlights__item">
          <span class="product-meta-highlights__icon" aria-hidden="true"><svg viewBox="0 0 20 20">{% render 'icon', icon: 'ruler' %}</svg></span>
          <div class="product-meta-highlights__copy">
            <strong>{{ weight }}</strong>
            <small>Weight</small>
          </div>
        </article>
      {% endif %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .product-meta-highlights {
    margin-top: 0;
    padding: 0;
  }

  .product-meta-highlights__heading {
    margin: 0 0 1.1rem;
    font-size: 1.35rem;
    font-weight: 650;
    color: #111111;
  }

  .product-meta-highlights__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .product-meta-highlights__item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    border-radius: 14px;
    background: #ffffff;
    padding: 0.95rem 1rem;
  }

  .product-meta-highlights__icon {
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
    color: #737373;
    flex: 0 0 auto;
  }

  .product-meta-highlights__icon svg {
    width: 100%;
    height: 100%;
  }

  .product-meta-highlights__copy {
    display: grid;
    min-width: 0;
    line-height: 1.1;
  }

  .product-meta-highlights__copy strong {
    font-size: 0.8rem;
    font-weight: 600;
    color: #111111;
  }

  .product-meta-highlights__copy small {
    margin-top: 0.2rem;
    color: #767676;
    font-size: 0.64rem;
  }

  @media screen and (max-width: 989px) {
    .product-meta-highlights__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .product-meta-highlights__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Metafield highlights",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product highlights"
    },
    {
      "type": "paragraph",
      "content": "Reads product.metafields.custom.processor / ram / storage / display / battery_life / weight. No fallback text — an item is hidden if its metafield is blank, and the whole section is hidden if none are set."
    }
  ],
  "presets": [
    {
      "name": "Metafield highlights",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
