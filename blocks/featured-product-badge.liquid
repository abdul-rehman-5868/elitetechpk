<div
  class="featured-product-badge{% if block.settings.hide_on_mobile %} featured-product-badge--hide-mobile{% endif %}"
  style="
    --fpb-size: {{ block.settings.size }}px;
    --fpb-bg: {{ block.settings.background_color }};
    --fpb-fg: {{ block.settings.text_color }};
  "
  {{ block.shopify_attributes }}
  aria-hidden="true"
>
  <svg class="featured-product-badge__svg featured-product-badge__svg--spin" viewBox="0 0 120 120" role="img">
    <circle class="featured-product-badge__circle" cx="60" cy="60" r="58" />
    <defs>
      <path
        id="featured-product-badge-path-{{ block.id }}"
        d="M60,60 m-40,0 a40,40 0 1,1 80,0 a40,40 0 1,1 -80,0"
      />
    </defs>
    <text class="featured-product-badge__text">
      <textPath
        href="#featured-product-badge-path-{{ block.id }}"
        startOffset="0%"
      >
        {{ block.settings.label }}
      </textPath>
    </text>
  </svg>
  <span class="featured-product-badge__thumb" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" focusable="false">
      <path
        d="M8.5 11.5V20M8.5 11.5H5.8c-.9 0-1.3-.4-1.3-1.2V8.8c0-.8.4-1.3 1.3-1.3h2.7m0 4v-4m0 0 1.4-3.2c.3-.7.9-1.1 1.6-1.1.8 0 1.4.6 1.4 1.4V8.5h4.1c1.2 0 2.1 1.1 1.9 2.3l-.9 5.2c-.2 1.2-1.3 2-2.5 2H11"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>
</div>

{% stylesheet %}
  .featured-product-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 3;
    width: var(--fpb-size, 96px);
    height: var(--fpb-size, 96px);
    color: var(--fpb-fg, #111111);
    pointer-events: none;
  }

  .featured-product-badge__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .featured-product-badge__svg--spin {
    animation: featured-badge-spin 22s linear infinite;
    transform-origin: 50% 50%;
  }

  .featured-product-badge__circle {
    fill: var(--fpb-bg, #ffffff);
    stroke: #e8e8e8;
    stroke-width: 1;
  }

  .featured-product-badge__text {
    fill: currentColor;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .featured-product-badge__thumb {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: currentColor;
    pointer-events: none;
  }

  .featured-product-badge__thumb svg {
    width: 28%;
    height: 28%;
  }

  @keyframes featured-badge-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-product-badge__svg--spin {
      animation: none;
    }
  }

  @media screen and (max-width: 749px) {
    .featured-product-badge--hide-mobile {
      display: none;
    }

    .featured-product-badge {
      width: calc(var(--fpb-size, 96px) * 0.8);
      height: calc(var(--fpb-size, 96px) * 0.8);
      top: 0.75rem;
      right: 0.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured badge",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "FEATURED PRODUCT • FEATURED PRODUCT • "
    },
    {
      "type": "range",
      "id": "size",
      "label": "Size",
      "min": 64,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 96
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured badge",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
