<div
  class="product-highlights"
  style="--product-highlights-radius: {{ block.settings.corner_radius }}px;"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign highlight_product = closest.product
    assign meta_driver = highlight_product.metafields.custom.driver_size.value
    assign meta_weight = highlight_product.metafields.custom.product_weight.value
    assign meta_battery = highlight_product.metafields.custom.battery_life.value
    assign meta_bluetooth = highlight_product.metafields.custom.bluetooth_version.value
    assign meta_charging = highlight_product.metafields.custom.charging_time.value
    assign meta_range = highlight_product.metafields.custom.wireless_range.value
    assign has_meta_specs = false
    if meta_driver != blank or meta_weight != blank or meta_battery != blank or meta_bluetooth != blank or meta_charging != blank or meta_range != blank
      assign has_meta_specs = true
    endif
  %}

  {% if block.settings.heading != blank %}
    <h3 class="product-highlights__heading">{{ block.settings.heading }}</h3>
  {% endif %}

  <ul class="product-highlights__list" role="list">
    {% if has_meta_specs %}
      {% if meta_driver != blank %}
        <li class="product-highlights__item">
          <span class="product-highlights__icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" focusable="false">{%- render 'icon', icon: 'ruler' -%}</svg>
          </span>
          <span class="product-highlights__copy">
            <strong>{{ meta_driver }}</strong>
            <small>Driver size</small>
          </span>
        </li>
      {% endif %}
      {% if meta_weight != blank %}
        <li class="product-highlights__item">
          <span class="product-highlights__icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" focusable="false">{%- render 'icon', icon: 'box' -%}</svg>
          </span>
          <span class="product-highlights__copy">
            <strong>{{ meta_weight }}</strong>
            <small>Product weight</small>
          </span>
        </li>
      {% endif %}
      {% if meta_battery != blank %}
        <li class="product-highlights__item">
          <span class="product-highlights__icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" focusable="false">{%- render 'icon', icon: 'lightning_bolt' -%}</svg>
          </span>
          <span class="product-highlights__copy">
            <strong>{{ meta_battery }}</strong>
            <small>Battery life</small>
          </span>
        </li>
      {% endif %}
      {% if meta_bluetooth != blank %}
        <li class="product-highlights__item">
          <span class="product-highlights__icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" focusable="false">{%- render 'icon', icon: 'star' -%}</svg>
          </span>
          <span class="product-highlights__copy">
            <strong>{{ meta_bluetooth }}</strong>
            <small>Bluetooth</small>
          </span>
        </li>
      {% endif %}
      {% if meta_charging != blank %}
        <li class="product-highlights__item">
          <span class="product-highlights__icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" focusable="false">{%- render 'icon', icon: 'check_box' -%}</svg>
          </span>
          <span class="product-highlights__copy">
            <strong>{{ meta_charging }}</strong>
            <small>Charging time</small>
          </span>
        </li>
      {% endif %}
      {% if meta_range != blank %}
        <li class="product-highlights__item">
          <span class="product-highlights__icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" focusable="false">{%- render 'icon', icon: 'lightning_bolt' -%}</svg>
          </span>
          <span class="product-highlights__copy">
            <strong>{{ meta_range }}</strong>
            <small>Wireless range</small>
          </span>
        </li>
      {% endif %}
    {% else %}
      {% for index in (1..6) %}
        {% liquid
          assign icon_key = 'item_' | append: index | append: '_icon'
          assign title_key = 'item_' | append: index | append: '_title'
          assign caption_key = 'item_' | append: index | append: '_caption'
          assign item_icon = block.settings[icon_key]
          assign item_title = block.settings[title_key]
          assign item_caption = block.settings[caption_key]
        %}
        {% if item_title != blank %}
          <li class="product-highlights__item">
            <span class="product-highlights__icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" focusable="false">
                {%- render 'icon', icon: item_icon -%}
              </svg>
            </span>
            <span class="product-highlights__copy">
              <strong>{{ item_title }}</strong>
              {% if item_caption != blank %}<small>{{ item_caption }}</small>{% endif %}
            </span>
          </li>
        {% endif %}
      {% endfor %}
    {% endif %}
  </ul>
</div>

{% stylesheet %}
  .product-highlights {
    margin: 1.25rem;
    padding: 1rem 1.25rem 1.25rem;
    border: 1px solid #e6e6e6;
    border-radius: var(--product-highlights-radius, 17px);
    background: #ffffff;
  }

  .product-highlights__heading {
    margin: 0 0 1rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .product-highlights__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-highlights__item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    padding: 0.75rem;
    border-radius: 10px;
    background: #f7f7f7;
  }

  .product-highlights__icon {
    display: inline-flex;
    flex: 0 0 auto;
    width: 1.6rem;
    height: 1.6rem;
    color: #666666;
  }

  .product-highlights__icon svg {
    width: 100%;
    height: 100%;
  }

  .product-highlights__copy {
    display: grid;
    min-width: 0;
    line-height: 1.15;
  }

  .product-highlights__copy strong {
    overflow: hidden;
    font-size: 0.8rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-highlights__copy small {
    margin-top: 0.2rem;
    color: #777777;
    font-size: 0.65rem;
  }

  @media screen and (max-width: 749px) {
    .product-highlights {
      margin: 0.75rem;
      padding: 1rem;
    }

    .product-highlights__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

