<div
  id="ProductSupport-{{ section.id }}"
  class="product-service-panel"
  style="
    --psp-bg: {{ block.settings.background_color }};
    --psp-card-bg: {{ block.settings.card_background }};
    --psp-radius: {{ block.settings.corner_radius }}px;
  "
  {{ block.shopify_attributes }}
>
  <ul class="product-service-panel__list" role="list">
    {% if block.settings.item_1_text != blank %}
      <li class="product-service-panel__item">
        <span class="product-service-panel__icon" aria-hidden="true">
          <svg class="product-service-panel__icon-media" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20">
            {%- render 'icon', icon: block.settings.item_1_icon -%}
          </svg>
        </span>
        <span class="product-service-panel__text">{{ block.settings.item_1_text }}</span>
      </li>
    {% endif %}

    {% if block.settings.item_2_text != blank %}
      <li class="product-service-panel__item">
        <span class="product-service-panel__icon" aria-hidden="true">
          <svg class="product-service-panel__icon-media" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20">
            {%- render 'icon', icon: block.settings.item_2_icon -%}
          </svg>
        </span>
        <span class="product-service-panel__text">{{ block.settings.item_2_text }}</span>
      </li>
    {% endif %}

    {% if block.settings.item_3_text != blank %}
      <li class="product-service-panel__item">
        <span class="product-service-panel__icon" aria-hidden="true">
          <svg class="product-service-panel__icon-media" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20">
            {%- render 'icon', icon: block.settings.item_3_icon -%}
          </svg>
        </span>
        <span class="product-service-panel__text">{{ block.settings.item_3_text }}</span>
      </li>
    {% endif %}

    {% if block.settings.item_4_text != blank %}
      <li class="product-service-panel__item">
        <span class="product-service-panel__icon" aria-hidden="true">
          <svg class="product-service-panel__icon-media" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20">
            {%- render 'icon', icon: block.settings.item_4_icon -%}
          </svg>
        </span>
        <span class="product-service-panel__text">{{ block.settings.item_4_text }}</span>
      </li>
    {% endif %}
  </ul>
</div>

{% stylesheet %}
  .product-service-panel {
    width: 100%;
    background: var(--psp-bg, #f3f3f3);
    border-radius: var(--psp-radius, 17px);
    padding: 0.35rem;
  }

  .product-service-panel__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .product-service-panel__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--psp-card-bg, #ffffff);
    border-radius: 12px;
    margin: 0.35rem 0.5rem;
    padding: 0.9rem 1rem;
  }

  .product-service-panel__icon {
    display: inline-flex;
    flex-shrink: 0;
    color: #111111;
  }

  .product-service-panel__icon-media {
    width: 1.125rem;
    height: 1.125rem;
    display: block;
  }

  .product-service-panel__text {
    font-size: 0.875rem;
    line-height: 1.35;
    color: #222222;
  }
{% endstylesheet %}

