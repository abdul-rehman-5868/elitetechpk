{% liquid
  assign block_settings = block.settings
  assign block_index = section.blocks | find_index: 'id', block.id
  assign section_index = section.index
  assign desktop_image = block_settings.image
  assign mobile_image = block_settings.image_mobile
  if mobile_image == blank
    assign mobile_image = desktop_image
  endif
%}

{% capture children %}
  <div class="peek-slide__media">
    {%- if desktop_image != blank -%}
      {%- liquid
        assign widths = '832, 1200, 1600, 1920, 2560, 3840'
        assign mobile_widths = '416, 600, 800, 1200, 1600'
        assign loading = 'lazy'
        assign fetchpriority = 'low'
        if block_index == 0 and section_index <= 3
          assign loading = 'eager'
        endif
        if block_index == 0 and section_index == 1
          assign fetchpriority = 'high'
        endif
      -%}
      <picture>
        {% if block_settings.image_mobile != blank %}
          <source
            media="(max-width: 749px)"
            srcset="
              {%- assign mobile_widths_array = mobile_widths | split: ', ' -%}
              {%- for width in mobile_widths_array -%}
                {{ mobile_image | image_url: width: width }} {{ width }}w{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            "
            sizes="90vw"
          >
        {% endif %}
        {{
          desktop_image
          | image_url: width: 3840
          | image_tag:
            widths: widths,
            sizes: '90vw',
            class: 'peek-slide__image',
            loading: loading,
            fetchpriority: fetchpriority,
            alt: desktop_image.alt
        }}
      </picture>
    {%- else -%}
      {%- liquid
        assign modulo_result = block_index | modulo: 2
        assign placeholder_variant = 2 | minus: modulo_result
        assign placeholder_name = 'hero-apparel-' | append: placeholder_variant
      -%}
      {{ placeholder_name | placeholder_svg_tag: 'peek-slide__image peek-slide__image--placeholder' }}
    {%- endif -%}

    {% if block_settings.toggle_overlay %}
      <div
        class="peek-slide__overlay"
        style="
          --overlay-color: {{ block_settings.overlay_color }};
          {% if block_settings.overlay_style == 'gradient' %}
            background: linear-gradient({{ block_settings.gradient_direction }}, {{ block_settings.overlay_color }}, transparent);
          {% else %}
            background: {{ block_settings.overlay_color }};
          {% endif %}
        "
      ></div>
    {% endif %}
  </div>

  <div
    class="peek-slide__content"
    style="
      --heading-color: {{ block_settings.heading_color }};
      --button-bg: {{ block_settings.button_background }};
      --button-fg: {{ block_settings.button_text_color }};
    "
    {{ block.shopify_attributes }}
  >
    {% if block_settings.heading != blank %}
      <h2 class="peek-slide__heading">{{ block_settings.heading }}</h2>
    {% endif %}

    {% if block_settings.button_label != blank %}
      {% if block_settings.button_link != blank %}
        <a class="peek-slide__button" href="{{ block_settings.button_link }}">
          {{ block_settings.button_label }}
        </a>
      {% else %}
        <span class="peek-slide__button">{{ block_settings.button_label }}</span>
      {% endif %}
    {% endif %}
  </div>
{% endcapture %}

{% render 'slideshow-slide',
  index: block_index,
  class: 'peek-slide',
  children: children,
  attributes: block.shopify_attributes,
  slide_size: section.settings.slide_height,
  slide_id: block.id,
  navigate_to_slide: true
%}

{% stylesheet %}
  .peek-slide {
    --peek-r: var(--peek-panel-radius, var(--peek-corner-radius, 17px));
    position: relative;
    overflow: hidden;
    background: #2a2a2a;
    transition: border-radius 0.28s ease;
  }

  .peek-slide__media {
    position: absolute;
    inset: 0;
  }

  .peek-slide__media picture,
  .peek-slide__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .peek-slide__image--placeholder {
    background: linear-gradient(180deg, #cfcfcf 0%, #2a2a2a 100%);
  }

  .peek-slide__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .peek-slide__content {
    position: relative;
    z-index: var(--layer-flat);
    height: 100%;
    min-height: inherit;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
    padding-inline: var(--peek-content-inset-x, max(1.25rem, calc(var(--homepage-content-x-mobile, 20px) - var(--peek-side, 3%) - var(--peek-gap, 12px))));
    padding-block-start: clamp(1.5rem, 3.5vw, 2.75rem);
    padding-block-end: var(--peek-bottom-pad, clamp(2.75rem, 5vw, 3.75rem));
    pointer-events: none;
  }

  .peek-slide__heading {
    margin: 0;
    width: min(52%, 554px);
    max-width: 554px;
    color: var(--heading-color, #ffffff);
    font-family: Inter, var(--font-heading--family);
    font-size: 51.2px;
    font-style: normal;
    line-height: 51.23px;
    letter-spacing: -1.54px;
    text-transform: uppercase;
    font-weight: 700;
  }

  .peek-slide__button {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.4rem;
    border-radius: 999px;
    background: var(--button-bg, #ffffff);
    color: var(--button-fg, #111111);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .peek-slide__content {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      gap: 1rem;
    }

    .peek-slide__heading {
      width: 100%;
      max-width: 100%;
      font-size: clamp(2rem, 9vw, 3.2rem);
      line-height: 0.98;
      letter-spacing: -0.03em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Peek slide",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Experience unparalleled audio elegance."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Headphones"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "Enable overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#00000066",
      "alpha": true,
      "visible_if": "{{ block.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Overlay style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "gradient", "label": "Gradient" }
      ],
      "default": "gradient",
      "visible_if": "{{ block.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "Gradient direction",
      "options": [
        { "value": "to top", "label": "Up" },
        { "value": "to bottom", "label": "Down" }
      ],
      "default": "to top",
      "visible_if": "{{ block.settings.toggle_overlay and block.settings.overlay_style == 'gradient' }}"
    }
  ],
  "presets": [
    {
      "name": "Peek slide"
    }
  ]
}
{% endschema %}
