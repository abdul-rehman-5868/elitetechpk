{% liquid
  assign product = closest.product
  assign block_settings = block.settings
  assign linked_products = blank
  assign is_upgrades = false

  if block_settings.source == 'upgrades'
    assign linked_products = product.metafields.custom.pdp_upgrades.value
    assign is_upgrades = true
  else
    assign linked_products = product.metafields.custom.pdp_pairs_well_with.value
  endif
%}

{% if linked_products != blank and linked_products.size > 0 %}
  {% liquid
    assign anchor_id = 'ProductPairs'
    if is_upgrades
      assign anchor_id = 'ProductUpgrades'
    endif
  %}

  {% if is_upgrades %}
    <product-upgrades-accordion
      id="{{ anchor_id }}"
      class="product-linked-products product-linked-products--upgrades"
      data-open="false"
      {{ block.shopify_attributes }}
    >
      <button
        type="button"
        class="product-linked-products__toggle"
        data-upgrades-toggle
        aria-expanded="false"
        aria-controls="UpgradesPanel-{{ block.id }}"
      >
        <span class="product-linked-products__toggle-start">
          <span class="product-linked-products__toggle-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="3.5" y="5" width="13" height="11" rx="2" stroke="currentColor" stroke-width="1.4"/>
              <path d="M7 5V4.5a3 3 0 0 1 6 0V5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="product-linked-products__heading">{{ block_settings.heading }}</span>
        </span>
        <span class="product-linked-products__toggle-end" aria-hidden="true">
          <span class="product-linked-products__plus">+</span>
          <span class="product-linked-products__close">×</span>
        </span>
      </button>

      <div
        id="UpgradesPanel-{{ block.id }}"
        class="product-linked-products__panel"
        data-upgrades-panel
        hidden
      >
        <div class="product-linked-products__list" role="list">
          {% for linked_product in linked_products limit: block_settings.max_products %}
            {% assign linked_variant = linked_product.selected_or_first_available_variant %}
            <label class="product-linked-products__upgrade" role="listitem">
              <input
                class="product-linked-products__checkbox"
                type="checkbox"
                name="upgrade-{{ block.id }}"
                value="{{ linked_variant.id }}"
              >
              <span class="product-linked-products__media" aria-hidden="true">
                {% if linked_product.featured_image != blank %}
                  {{
                    linked_product.featured_image
                    | image_url: width: 160
                    | image_tag:
                      loading: 'lazy',
                      widths: '80, 120, 160',
                      sizes: '48px',
                      alt: ''
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'product-linked-products__placeholder' }}
                {% endif %}
              </span>
              <span class="product-linked-products__upgrade-copy">
                <a class="product-linked-products__title" href="{{ linked_product.url }}">{{ linked_product.title }}</a>
              </span>
              <span class="product-linked-products__price">
                {{ linked_variant.price | default: linked_product.price | money }}
              </span>
            </label>
          {% endfor %}
        </div>
      </div>
    </product-upgrades-accordion>
  {% else %}
    <product-pairs-carousel
      id="{{ anchor_id }}"
      class="product-linked-products product-linked-products--pairs"
      {{ block.shopify_attributes }}
    >
      <div class="product-linked-products__header">
        {% if block_settings.heading != blank %}
          <h3 class="product-linked-products__heading">{{ block_settings.heading }}</h3>
        {% endif %}
        <div class="product-linked-products__nav">
          <button type="button" class="product-linked-products__arrow" data-pairs-previous aria-label="Previous product">
            <span aria-hidden="true">‹</span>
          </button>
          <button type="button" class="product-linked-products__arrow" data-pairs-next aria-label="Next product">
            <span aria-hidden="true">›</span>
          </button>
        </div>
      </div>

      <div class="product-linked-products__track" data-pairs-track>
        {% for linked_product in linked_products limit: block_settings.max_products %}
          {% assign linked_variant = linked_product.selected_or_first_available_variant %}
          <article class="product-linked-products__item" role="listitem">
            <a class="product-linked-products__media" href="{{ linked_product.url }}">
              {% if linked_product.featured_image != blank %}
                {{
                  linked_product.featured_image
                  | image_url: width: 220
                  | image_tag:
                    loading: 'lazy',
                    widths: '80, 120, 180, 220',
                    sizes: '64px',
                    alt: linked_product.featured_image.alt
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'product-linked-products__placeholder' }}
              {% endif %}
            </a>

            <div class="product-linked-products__copy">
              <a class="product-linked-products__title" href="{{ linked_product.url }}">{{ linked_product.title }}</a>
              <span class="product-linked-products__price">
                {% liquid
                  assign linked_price = linked_variant.price | default: linked_product.price
                  assign linked_compare = linked_variant.compare_at_price
                %}
                {% if linked_compare > linked_price %}
                  <span class="product-linked-products__price--sale">{{ linked_price | money }}</span>
                  <span class="product-linked-products__price--compare">{{ linked_compare | money }}</span>
                {% else %}
                  {{ linked_price | money }}
                {% endif %}
              </span>
            </div>

            <a class="product-linked-products__cta" href="{{ linked_product.url }}">+ View</a>
          </article>
        {% endfor %}
      </div>
    </product-pairs-carousel>
  {% endif %}

  <script src="{{ 'product-linked-products.js' | asset_url }}" type="module"></script>
{% endif %}

{% stylesheet %}
  .product-linked-products {
    display: block;
    width: 100%;
  }

  .product-linked-products--upgrades {
    border-radius: 14px;
    background: #f3f3f3;
    overflow: hidden;
  }

  .product-linked-products__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    margin: 0;
    padding: 0.95rem 1rem;
    border: 0;
    background: transparent;
    color: #111111;
    cursor: pointer;
    text-align: left;
  }

  .product-linked-products__toggle-start {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
  }

  .product-linked-products__toggle-icon {
    display: inline-flex;
    color: #222222;
    flex: none;
  }

  .product-linked-products__heading {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .product-linked-products__toggle-end {
    position: relative;
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    font-size: 1.35rem;
    line-height: 1;
  }

  .product-linked-products__plus,
  .product-linked-products__close {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-linked-products__close {
    opacity: 0;
  }

  .product-linked-products--upgrades[data-open='true'] .product-linked-products__plus {
    opacity: 0;
  }

  .product-linked-products--upgrades[data-open='true'] .product-linked-products__close {
    opacity: 1;
  }

  .product-linked-products__panel {
    padding: 0 0.85rem 0.85rem;
  }

  .product-linked-products__panel[hidden] {
    display: none;
  }

  .product-linked-products--upgrades .product-linked-products__list {
    display: grid;
    gap: 0;
    border-radius: 12px;
    background: #ffffff;
    overflow: hidden;
  }

  .product-linked-products__upgrade {
    display: grid;
    grid-template-columns: auto 3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 0.9rem;
    border-top: 1px solid #efefef;
    cursor: pointer;
  }

  .product-linked-products__upgrade:first-child {
    border-top: 0;
  }

  .product-linked-products__checkbox {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: #111111;
  }

  .product-linked-products--upgrades .product-linked-products__media {
    display: block;
    width: 3rem;
    height: 3rem;
    overflow: hidden;
    border-radius: 8px;
    background: #f5f5f5;
  }

  .product-linked-products__upgrade-copy {
    min-width: 0;
  }

  .product-linked-products--upgrades .product-linked-products__title {
    display: block;
    overflow: hidden;
    color: #111111;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .product-linked-products--upgrades .product-linked-products__price {
    color: #111111;
    font-size: 0.88rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .product-linked-products--pairs .product-linked-products__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .product-linked-products__nav {
    display: inline-flex;
    gap: 0.35rem;
  }

  .product-linked-products__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 1px solid #d8d8d8;
    border-radius: 999px;
    background: #ffffff;
    color: #111111;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  .product-linked-products__arrow:disabled,
  .product-linked-products__arrow.is-disabled {
    opacity: 0.35;
    cursor: default;
  }

  .product-linked-products__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .product-linked-products__track::-webkit-scrollbar {
    display: none;
  }

  .product-linked-products--pairs .product-linked-products__item {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem;
    border-radius: 14px;
    background: #f5f5f5;
    scroll-snap-align: start;
  }

  .product-linked-products--pairs .product-linked-products__media {
    display: block;
    width: 4rem;
    height: 4rem;
    overflow: hidden;
    border-radius: 10px;
    background: #ffffff;
  }

  .product-linked-products__media img,
  .product-linked-products__media svg,
  .product-linked-products__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .product-linked-products--pairs .product-linked-products__copy {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .product-linked-products--pairs .product-linked-products__title {
    overflow: hidden;
    color: #111111;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .product-linked-products--pairs .product-linked-products__heading {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .product-linked-products--pairs .product-linked-products__price {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 0.875rem;
    color: #111111;
    font-weight: 500;
  }

  .product-linked-products--pairs .product-linked-products__price--sale {
    color: #d0021b;
  }

  .product-linked-products--pairs .product-linked-products__price--compare {
    color: #8a8a8a;
    text-decoration: line-through;
    font-weight: 400;
    margin-inline-start: 0.35rem;
  }

  .product-linked-products__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 5.1rem;
    min-height: 2.15rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: #111111;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.82rem;
    white-space: nowrap;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Linked products",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "value": "upgrades", "label": "Popular upgrades" },
        { "value": "pairs", "label": "Pairs well with" }
      ],
      "default": "upgrades"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular upgrades"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Linked products",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
