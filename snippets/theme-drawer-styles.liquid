{% doc %}
  Theme Drawer Styles

  Styles-only snippet extracted from theme-drawer.liquid. Renders the shared
  structural CSS for theme-drawer dialogs without the accompanying scripts,
  so it can be included from contexts that need the classes in scope without
  duplicating the drawer behaviour.

  @example
  {% render 'theme-drawer-styles' %}
{% enddoc %}

{% stylesheet %}
  theme-drawer {
    display: contents;
  }

  .theme-drawer__dialog {
    --theme-drawer-padding: var(--padding-xl);
    --theme-drawer-animation-speed: var(--animation-speed);
    --theme-drawer-animation-ease: cubic-bezier(0.22, 1, 0.36, 1);

    z-index: calc(var(--layer-sticky) + var(--drawer-stack-order, 0));
    position: fixed;
    inset: unset;
    top: 0;
    right: calc(-1 * var(--theme-drawer-width, var(--sidebar-width)));
    left: auto;
    flex-direction: column;
    width: var(--theme-drawer-width, var(--sidebar-width));
    max-width: 100%;
    max-height: none;
    height: 100dvh;
    padding: 0;
    border: none;
    border-left: var(--style-border-drawer);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  theme-drawer[data-side='start'] .theme-drawer__dialog {
    right: auto;
    left: calc(-1 * var(--theme-drawer-width, var(--sidebar-width)));
    border-left: none;
    border-right: var(--style-border-drawer);
  }

  .theme-drawer__dialog[open] {
    display: flex;
    right: 0;
  }

  theme-drawer[data-side='start'] .theme-drawer__dialog[open] {
    right: auto;
    left: 0;
  }

  theme-drawer[overlay] .theme-drawer__dialog {
    --theme-drawer-width: min(calc(26.5rem + 100px), calc(100vw - 1.5rem));
    --theme-drawer-animation-speed: 0.55s;
    top: 0.75rem;
    bottom: 0.75rem;
    height: auto;
    max-height: calc(100dvh - 1.5rem);
    border: none;
    border-radius: 28px;
    overflow: hidden;
    background: #ffffff;
    color: #171717;
    box-shadow: 0 18px 56px rgb(0 0 0 / 18%);
  }

  theme-drawer[overlay]:not([data-side='start']) .theme-drawer__dialog,
  theme-drawer[overlay]:not([data-side='start']) .theme-drawer__dialog[open] {
    right: 0.75rem;
    left: auto;
  }

  theme-drawer[overlay][data-side='start'] .theme-drawer__dialog,
  theme-drawer[overlay][data-side='start'] .theme-drawer__dialog[open] {
    left: 0.75rem;
    right: auto;
  }

  .theme-drawer__dialog--opening {
    animation: drawer-slide-in var(--theme-drawer-animation-speed) var(--theme-drawer-animation-ease);
  }

  .theme-drawer__dialog--opening-inline-start {
    animation: drawer-slide-in-inline-start var(--theme-drawer-animation-speed) var(--theme-drawer-animation-ease);
  }

  .theme-drawer__dialog--opening-start {
    animation: drawer-slide-in-start var(--theme-drawer-animation-speed) var(--theme-drawer-animation-ease);
  }

  .theme-drawer__dialog--closing {
    animation: drawer-slide-out var(--theme-drawer-animation-speed) var(--theme-drawer-animation-ease) forwards;
  }

  .theme-drawer__dialog--closing-start {
    animation: drawer-slide-out-start var(--theme-drawer-animation-speed) var(--theme-drawer-animation-ease) forwards;
  }

  .theme-drawer__dialog-instant {
    animation: none;
  }

  theme-drawer[overlay]:not([data-side='start']) .theme-drawer__dialog--opening {
    animation-name: drawer-overlay-slide-in-end;
  }

  theme-drawer[overlay]:not([data-side='start']) .theme-drawer__dialog--closing {
    animation-name: drawer-overlay-slide-out-end;
  }

  theme-drawer[overlay][data-side='start'] .theme-drawer__dialog--opening-start {
    animation-name: drawer-overlay-slide-in-start;
  }

  theme-drawer[overlay][data-side='start'] .theme-drawer__dialog--closing-start {
    animation-name: drawer-overlay-slide-out-start;
  }

  @keyframes drawer-slide-in {
    from {
      right: calc(-1 * var(--theme-drawer-width, var(--sidebar-width)));
    }
  }

  @keyframes drawer-slide-in-inline-start {
    from {
      right: calc(var(--theme-drawer-width, var(--sidebar-width)) / 2);
    }
  }

  @keyframes drawer-slide-in-start {
    from {
      left: calc(-1 * var(--theme-drawer-width, var(--sidebar-width)));
    }
  }

  @keyframes drawer-slide-out {
    to {
      right: calc(-1 * var(--theme-drawer-width, var(--sidebar-width)));
    }
  }

  @keyframes drawer-slide-out-start {
    to {
      left: calc(-1 * var(--theme-drawer-width, var(--sidebar-width)));
    }
  }

  @keyframes drawer-overlay-slide-in-end {
    from {
      right: calc(-1 * var(--theme-drawer-width, var(--sidebar-width)) - 0.75rem);
    }
  }

  @keyframes drawer-overlay-slide-out-end {
    to {
      right: calc(-1 * var(--theme-drawer-width, var(--sidebar-width)) - 0.75rem);
    }
  }

  @keyframes drawer-overlay-slide-in-start {
    from {
      left: calc(-1 * var(--theme-drawer-width, var(--sidebar-width)) - 0.75rem);
    }
  }

  @keyframes drawer-overlay-slide-out-start {
    to {
      left: calc(-1 * var(--theme-drawer-width, var(--sidebar-width)) - 0.75rem);
    }
  }

  .theme-drawer__dialog::backdrop {
    background: rgb(var(--backdrop-color-rgb) / var(--backdrop-opacity));
  }

  theme-drawer[overlay] .theme-drawer__dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(2px);
  }

  /* Exclude open drawers from the page navigation cross-fade so they
     stay frozen (visually unchanged) while the rest of the page transitions. */
  html:active-view-transition-type(page-navigation) .theme-drawer__dialog[open] {
    view-transition-name: theme-drawer;
  }

  ::view-transition-old(theme-drawer),
  ::view-transition-new(theme-drawer) {
    animation: none;
  }

  .theme-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--theme-drawer-padding);
    flex-shrink: 0;
    color: var(--color-foreground);
  }

  .theme-drawer__title {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    margin: 0;
  }

  .theme-drawer__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    flex-shrink: 0;
    border-radius: var(--style-border-radius-lg);
    background-color: rgb(var(--color-foreground-rgb) / 0.1);
    font-family: var(--font-paragraph--family);
    font-weight: var(--font-paragraph--weight);
    color: var(--color-foreground);
    font-size: clamp(var(--font-size--3xs), 0.75em, var(--font-size--xs));
    padding-inline: 0.5em;
    line-height: 1;
  }

  .theme-drawer__badge[data-maintain-ratio] {
    aspect-ratio: 1 / 1;
    padding-inline: 0.2em;
  }

  .theme-drawer__close-button {
    --private-button-size: 34px;
    --private-focus-ring-size: 2px;
    --private-motion-speed: 150ms;
    --private-motion-ease: cubic-bezier(0.25, 0, 0.1, 1);
    --private-border-width: 1px;
    --private-button-border-color: rgb(0, 0, 0, 0.06);
    --private-button-shadow: 0 2px 6px 0 var(--private-button-border-color);

    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-inline-start: auto;
    width: var(--private-button-size);
    height: var(--private-button-size);
    border-radius: var(--private-button-size);
    background-color: var(--color-background);
    outline: var(--private-focus-ring-size) solid transparent;
    outline-offset: var(--private-focus-ring-size);
    transition-property: color, outline-color, background-color;
    transition-duration: var(--private-motion-speed);
    transition-timing-function: var(--private-motion-ease);

    /* Legacy non-contrast-aware color scheme */
    --button-icon-opacity: 0.8;
    color: var(--color-foreground);
    border: var(--private-border-width) solid var(--private-button-border-color);
    box-shadow: var(--private-button-shadow);

    &:hover:not(:active) {
      /* Legacy non-contrast-aware color scheme */
      --button-icon-opacity: 1;
    }

    &:focus-visible {
      outline-color: var(--color-foreground);
    }
  }

  @supports (color: oklch(from red l c h)) {
    .theme-drawer__close-button {
      --contrast-color: oklch(from var(--color-background) clamp(0, (0.6 / l - 1) * infinity, 1) 0 0);
      --button-icon-opacity: 1;
      --private-button-border-color: color-mix(in srgb, var(--contrast-color) 6%, transparent);
      --private-button-shadow: 0 2px 6px 0 var(--private-button-border-color);

      color: color-mix(in srgb, var(--contrast-color) 50%, transparent);

      &:hover:not(:active) {
        color: color-mix(in srgb, var(--contrast-color) 70%, transparent);
      }
    }

    .theme-drawer__close-button:hover:not(:active) {
      background-color: color-mix(in srgb, var(--contrast-color) 6%, var(--color-background));
    }
  }
{% endstylesheet %}
