{% doc %}
  Renders the search modal dialog with predictive search.

  @param {block} [block] - The block object, used for Shopify editor attributes.
  @param {string} [class] - Additional CSS classes to apply to the predictive search component.
{% enddoc %}

{% render 'predictive-search-styles' %}

<script
  src="{{ 'dialog.js' | asset_url }}"
  type="module"
></script>

<script
  src="{{ 'predictive-search.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<script
  src="{{ 'search-modal-typewriter.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<dialog-component
  id="search-modal"
  class="search-modal"
  {{ block.shopify_attributes }}
>
  <dialog
    ref="dialog"
    on:click="/closeDialogOnClickOutside"
    on:keydown="/closeDialogOnEscapePress"
    class="search-modal__content dialog-modal"
    scroll-lock
    aria-labelledby="search-modal-heading"
  >
    <div class="search-modal__panel">
      <div class="search-modal__header">
        <h2 id="search-modal-heading" class="search-modal__title">
          {{ 'content.search' | t }}
        </h2>
        <button
          type="button"
          class="search-modal__close"
          aria-label="{{ 'accessibility.close_dialog' | t }}"
          on:click="dialog-component/closeDialog"
          ref="closeModalButton"
        >
          <span class="svg-wrapper">
            {{ 'icon-close.svg' | inline_asset_content }}
          </span>
        </button>
      </div>

      <predictive-search-component
        class="predictive-search search-modal__predictive{% if class != blank %} {{ class | strip }}{% endif %}"
        data-section-id="predictive-search"
        data-testid="{{ 'search-component--modal' }}"
        role="search"
        aria-label="{{ 'content.search_input_label' | t }}"
      >
        <form
          action="{{ routes.search_url }}"
          method="get"
          role="search"
          class="predictive-search-form search-modal__form"
          ref="form"
          on:keydown="/onSearchKeyDown"
        >
          <div class="search-modal__input-wrap">
            <label class="visually-hidden" for="search-modal-input">
              {{- 'content.search_input_label' | t -}}
            </label>
            <input
              class="search-input search-modal__input"
              id="search-modal-input"
              type="search"
              name="q"
              role="combobox"
              aria-expanded="false"
              aria-owns="predictive-search-results"
              aria-controls="predictive-search-results"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocomplete="off"
              placeholder=""
              data-final-placeholder="{{ settings.search_final_placeholder | default: 'Search for ...' }}"
              ref="searchInput"
              on:input="/search"
              on:keydown="/onSearchKeyDown"
            >
            <div
              class="search-modal__typewriter search-modal__typewriter--hidden"
              aria-hidden="true"
              data-words="{{ settings.search_typewriter_words | default: 'laptops, rams, chargers, anything' | escape }}"
            >
              <span class="search-modal__typewriter-text"></span>
              <span class="search-modal__typewriter-cursor">|</span>
            </div>
            <input name="options[prefix]" type="hidden" value="last">
            <button
              type="button"
              class="search-modal__clear button-unstyled"
              ref="resetButton"
              hidden
              on:click="/resetSearch"
            >
              {{ 'actions.clear' | t }}
            </button>
          </div>

          <div class="search-modal__body">
            <div
              class="search-modal__results"
              ref="predictiveSearchResults"
              on:click="/handleModalClick"
            >
              {% render 'predictive-search-modal-default-state', shadow_opacity: 0.1 %}
            </div>
          </div>

          <div class="search-modal__footer">
            <button
              type="submit"
              class="search-modal__submit"
              ref="viewAllButton"
            >
              <span>See all results</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>
        </form>
      </predictive-search-component>
    </div>
  </dialog>
</dialog-component>

{% stylesheet %}
  .search-modal__content {
    --search-drawer-width: min(33.6rem, calc(100vw - 1.5rem));
    --search-modal-pad: calc(2rem + 10px);

    position: fixed;
    inset: 0.75rem 0.75rem 0.75rem auto;
    width: var(--search-drawer-width);
    max-width: calc(100vw - 1.5rem);
    height: auto;
    max-height: calc(100dvh - 1.5rem);
    margin: 0;
    padding: 0;
    border: 0;
    /* Matches the cart drawer's floating-card corner treatment (all four
       corners rounded at the same radius) — both panels already share the
       same 0.75rem inset from the top/right/bottom edges, so this makes the
       two consistent instead of search's previous flat right edge. */
    border-radius: 28px;
    overflow: hidden;
    background: #ffffff;
    color: #111111;
    box-shadow: 0 18px 56px rgb(0 0 0 / 18%);
  }

  .search-modal__content::backdrop {
    background: rgb(0 0 0 / 0.42);
    backdrop-filter: blur(1px);
  }

  .search-modal__content[open] {
    display: flex;
    flex-direction: column;
  }

  .dialog-modal[open].search-modal__content {
    animation: search-drawer-slide-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .dialog-modal.search-modal__content.dialog-closing {
    animation: search-drawer-slide-out 0.35s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes search-drawer-slide-in {
    from {
      transform: translateX(calc(100% + 0.75rem));
      opacity: 0.92;
    }

    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes search-drawer-slide-out {
    from {
      transform: translateX(0);
      opacity: 1;
    }

    to {
      transform: translateX(calc(100% + 0.75rem));
      opacity: 0.92;
    }
  }

  .search-modal__panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
    height: 100%;
    max-height: calc(100dvh - 1.5rem);
  }

  .search-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: var(--search-modal-pad) var(--search-modal-pad) 1.25rem;
    border-bottom: 1px solid #ebebeb;
  }

  .search-modal__title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: #111111;
  }

  .search-modal__close {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    padding: 0;
    border: 1px solid #e0e0e0;
    border-radius: 50%;
    background: #ffffff;
    color: #111111;
    cursor: pointer;
    transition: background-color 180ms ease;
  }

  .search-modal__close:hover {
    background: #f7f7f7;
  }

  .search-modal__close .svg-wrapper,
  .search-modal__close svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  .search-modal__predictive,
  .search-modal__form {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
  }

  .search-modal__input-wrap {
    position: relative;
    padding: 0 var(--search-modal-pad) 1.35rem;
  }

  .search-modal__typewriter {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--search-modal-pad) + 1rem);
    right: calc(var(--search-modal-pad) + 4.25rem);
    display: flex;
    align-items: center;
    gap: 0.1rem;
    color: #111111;
    font-size: 0.95rem;
    line-height: 1.4;
    pointer-events: none;
    transform-origin: left center;
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease;
    white-space: nowrap;
    overflow: hidden;
  }

  .search-modal__typewriter--hidden {
    opacity: 0;
    visibility: hidden;
  }

  .search-modal__typewriter--squeezing {
    transform: scaleX(0.08) translateX(-0.15rem);
    opacity: 0.35;
  }

  .search-modal__typewriter-cursor {
    color: #111111;
    animation: search-typewriter-blink 1s step-end infinite;
  }

  @keyframes search-typewriter-blink {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0;
    }
  }

  .search-modal__default-section + .search-modal__default-section {
    margin-top: 0.25rem;
  }

  .search-modal__default-links {
    display: grid;
    gap: 0.75rem;
    margin: 0.95rem 0 0;
    padding: 0;
  }

  .search-modal__default-link {
    color: #111111;
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.6;
    text-decoration: none;
  }

  .search-modal__default-link:hover {
    opacity: 0.72;
  }

  .search-modal__input {
    width: 100%;
    padding: 0.9rem 4.25rem 0.9rem 1rem;
    border: 0;
    border-radius: 8px;
    background: #f5f5f5;
    color: #111111;
    font: inherit;
    font-size: 0.95rem;
    line-height: 1.4;
    outline: none;
  }

  .search-modal__input::placeholder {
    color: #9a9a9a;
  }

  .search-modal__clear {
    position: absolute;
    top: 50%;
    right: calc(var(--search-modal-pad) + 0.85rem);
    color: #707070;
    font-size: 0.8125rem;
    font-weight: 400;
    translate: 0 -50%;
    cursor: pointer;
  }

  .search-modal__clear[hidden] {
    display: none;
  }

  .search-modal__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
  }

  .search-modal__results,
  .search-modal__results .predictive-search-dropdown,
  .search-modal__results .predictive-search-results__inner {
    height: 100%;
  }

  .search-modal__results .predictive-search-results__inner {
    overflow-y: auto;
    padding: 0 var(--search-modal-pad) 0.5rem;
    scrollbar-width: none;
  }

  .search-modal__results .predictive-search-results__inner::-webkit-scrollbar {
    display: none;
  }

  .search-modal__footer {
    padding: 1rem var(--search-modal-pad) var(--search-modal-pad);
  }

  .search-modal__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.95rem 1.25rem;
    border: 0;
    border-radius: 999px;
    background: #111111;
    color: #ffffff;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    transition: opacity 180ms ease;
  }

  .search-modal__submit:hover {
    opacity: 0.88;
  }

  .search-modal .predictive-search-form__footer,
  .search-modal .predictive-search__icon,
  .search-modal .predictive-search-form__header {
    display: none;
  }

  .search-modal .predictive-search-form__content-wrapper {
    position: static;
    display: block;
    overflow: visible;
    border-radius: 0;
    box-shadow: none;
  }

  .search-modal .predictive-search-form__content {
    max-height: none;
    overflow: visible;
    padding: 0;
    background: transparent;
  }

  .search-modal .predictive-search-results__section {
    margin-bottom: 0.25rem;
  }

  .search-modal .predictive-search-results__section-label {
    margin: 0;
    padding: 1.35rem 0 0.7rem;
    border: 0;
    border-bottom: 1px solid #ebebeb;
    color: #9a9a9a;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .search-modal .predictive-search-results__section-label:first-child,
  .search-modal .predictive-search-results__section:first-child .predictive-search-results__section-label,
  .search-modal .predictive-search-results__products > .predictive-search-results__section-label:first-child {
    padding-top: 0;
  }

  .search-modal .predictive-search-results__suggestions {
    display: grid;
    gap: 0.55rem;
    margin: 0.95rem 0 0;
    padding: 0;
  }

  .search-modal .predictive-search-results__suggestion-link {
    display: block;
    padding: 0;
    color: #111111;
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.45;
    text-decoration: none;
  }

  .search-modal .predictive-search-results__suggestion-link mark {
    background: transparent;
    color: #b5b5b5;
    font-weight: 400;
  }

  .search-modal .predictive-search-results__rows {
    display: grid;
    gap: 1.25rem;
    margin: 0.95rem 0 0;
    padding: 0;
  }

  .search-modal .predictive-search-row-product {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .search-modal .predictive-search-row-product__media {
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: 8px;
    background: #f5f5f5;
  }

  .search-modal .predictive-search-row-product__media img,
  .search-modal .predictive-search-row-product__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .search-modal .predictive-search-row-product__copy {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .search-modal .predictive-search-row-product__copy strong {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    text-transform: none;
    color: #111111;
  }

  .search-modal .predictive-search-row-product__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
  }

  .search-modal .predictive-search-row-product__price {
    color: #111111;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .search-modal .predictive-search-row-product__price--sale {
    color: #b02a37;
  }

  .search-modal .predictive-search-row-product__compare {
    color: #9a9a9a;
    font-size: 0.875rem;
    font-weight: 400;
    text-decoration: line-through;
  }

  .search-modal .predictive-search-resource-list {
    margin-top: 0.25rem;
  }

  .search-modal .predictive-search-resource-list__items {
    display: grid;
    gap: 0.65rem;
    margin: 0.95rem 0 0;
    padding: 0;
  }

  .search-modal .predictive-search-resource-list__link {
    color: #111111;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    text-decoration: none;
    text-transform: none;
  }

  .search-modal .predictive-search-results__no-results {
    margin: 1.25rem 0 0;
    color: #707070;
    font-size: 0.9375rem;
    text-align: left;
  }

  .search-modal .predictive-search-results__products {
    padding: 0;
  }

  .search-modal .recently-viewed-wrapper .predictive-search-results__section-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .search-modal .predictive-search-results__clear {
    color: #707070;
    font-size: 0.8125rem;
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
  }

  predictive-search-component:not(:has([data-search-results])) .search-modal__footer,
  predictive-search-component:has(.predictive-search-results__no-results) .search-modal__footer {
    display: none;
  }

  @media screen and (max-width: 749px) {
    /* Bottom sheet on mobile, matching the menu drawer and cart drawer
       (rounded top, slides up) instead of the previous full-screen panel
       animated in from the right. Internal search/predictive-results
       markup is unchanged. */
    .search-modal__content {
      --search-modal-pad: calc(1.35rem + 10px);

      inset: auto 0 0 0;
      width: 100%;
      max-width: none;
      height: auto;
      min-height: 80vh;
      max-height: 88vh;
      border-radius: 20px 20px 0 0;
    }

    .search-modal__content::before {
      content: '';
      position: absolute;
      top: 0.6rem;
      left: 50%;
      transform: translateX(-50%);
      width: 2.25rem;
      height: 0.25rem;
      border-radius: 999px;
      background: rgb(0 0 0 / 0.18);
      pointer-events: none;
      z-index: 1;
    }

    .search-modal__panel {
      max-height: 88vh;
    }

    .dialog-modal[open].search-modal__content {
      animation: search-sheet-slide-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .dialog-modal.search-modal__content.dialog-closing {
      animation: search-sheet-slide-out 0.35s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @keyframes search-sheet-slide-in {
      from {
        transform: translateY(100%);
        opacity: 0.92;
      }

      to {
        transform: translateY(0);
        opacity: 1;
      }
    }

    @keyframes search-sheet-slide-out {
      from {
        transform: translateY(0);
        opacity: 1;
      }

      to {
        transform: translateY(100%);
        opacity: 0.92;
      }
    }
  }
{% endstylesheet %}
