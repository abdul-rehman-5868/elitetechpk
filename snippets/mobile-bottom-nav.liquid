{% doc %}
  Mobile Bottom Navigation Dock

  Fixed bottom tab bar shown on mobile only (<750px). Hidden by default;
  slides into view once the scroll-driven collapse activates (see
  assets/mobile-bottom-nav.js and the `body[data-mobile-nav-collapsed]`
  rules in sections/header.liquid), and slides away again when the header
  reappears.

  @example
  {% render 'mobile-bottom-nav' %}
{% enddoc %}

<script
  type="module"
  src="{{ 'cart-icon.js' | asset_url }}"
  fetchpriority="low"
></script>
<script
  type="module"
  src="{{ 'mobile-bottom-nav.js' | asset_url }}"
  fetchpriority="low"
></script>

<nav
  class="mobile-bottom-nav"
  aria-label="Quick navigation"
>
  <a
    href="{{ routes.root_url }}"
    class="mobile-bottom-nav__item{% if request.page_type == 'index' %} mobile-bottom-nav__item--active{% endif %}"
    {% if request.page_type == 'index' %}
      aria-current="page"
    {% endif %}
  >
    <span
      class="svg-wrapper mobile-bottom-nav__icon"
      aria-hidden="true"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
      >
        <path
          d="M4 11.5 12 4l8 7.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M6 10v9a1 1 0 0 0 1 1h3v-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5h3a1 1 0 0 0 1-1v-9"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </span>
    <span class="mobile-bottom-nav__label">Home</span>
  </a>

  <button
    type="button"
    class="mobile-bottom-nav__item"
    data-mobile-bottom-nav-menu
    aria-haspopup="dialog"
    aria-controls="Details-menu-drawer-container"
  >
    <span
      class="svg-wrapper mobile-bottom-nav__icon"
      aria-hidden="true"
    >
      {{- 'icon-menu.svg' | inline_asset_content -}}
    </span>
    <span class="mobile-bottom-nav__label">{{ 'accessibility.menu' | t }}</span>
  </button>

  <button
    type="button"
    class="mobile-bottom-nav__item"
    on:click="#search-modal/showDialog"
    aria-haspopup="dialog"
  >
    <span
      class="svg-wrapper mobile-bottom-nav__icon"
      aria-hidden="true"
    >
      {{- 'icon-search.svg' | inline_asset_content -}}
    </span>
    <span class="mobile-bottom-nav__label">{{ 'content.search' | t }}</span>
  </button>

  <a
    href="{{ routes.all_products_collection_url }}"
    class="mobile-bottom-nav__item"
  >
    <span
      class="svg-wrapper mobile-bottom-nav__icon"
      aria-hidden="true"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
      >
        <path
          d="M6 8h12l1 12.5a1 1 0 0 1-1 1.5H6a1 1 0 0 1-1-1.5L6 8Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        <path
          d="M9 8V6a3 3 0 0 1 6 0v2"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </svg>
    </span>
    <span class="mobile-bottom-nav__label">Shop</span>
  </a>

  {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
    <button
      type="button"
      class="mobile-bottom-nav__item"
      on:click="#cart-drawer/toggle"
      aria-haspopup="dialog"
      aria-controls="cart-drawer"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <cart-icon class="svg-wrapper mobile-bottom-nav__icon">
        {{- 'icon-cart.svg' | inline_asset_content -}}
        {% render 'cart-bubble', limit: 100 %}
      </cart-icon>
      <span class="mobile-bottom-nav__label">{{ 'content.cart_title' | t }}</span>
    </button>
  {% else %}
    <a
      href="{{ routes.cart_url }}"
      class="mobile-bottom-nav__item"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <cart-icon class="svg-wrapper mobile-bottom-nav__icon">
        {{- 'icon-cart.svg' | inline_asset_content -}}
        {% render 'cart-bubble', limit: 100 %}
      </cart-icon>
      <span class="mobile-bottom-nav__label">{{ 'content.cart_title' | t }}</span>
    </a>
  {% endif %}

  <a
    href="{% if shop.customer_accounts_enabled %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
    class="mobile-bottom-nav__item"
  >
    <span
      class="svg-wrapper mobile-bottom-nav__icon"
      aria-hidden="true"
    >
      {{- 'icon-account.svg' | inline_asset_content -}}
    </span>
    <span class="mobile-bottom-nav__label">{{ 'content.account_title' | t }}</span>
  </a>
</nav>

{% stylesheet %}
  .mobile-bottom-nav {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .mobile-bottom-nav {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      align-items: stretch;
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: var(--layer-menu-drawer);
      background: var(--color-background, #ffffff);
      border-top-left-radius: 20px;
      border-top-right-radius: 20px;
      box-shadow: 0 -8px 24px rgb(0 0 0 / 10%);
      padding-block: 0.6rem calc(0.6rem + env(safe-area-inset-bottom, 0px));
      padding-inline: 0.25rem;
      transform: translateY(100%);
      transition: transform var(--animation-speed-slow, 0.35s) cubic-bezier(0.22, 1, 0.36, 1);
    }

    body[data-mobile-nav-collapsed] .mobile-bottom-nav {
      transform: translateY(0);
    }
  }

  .mobile-bottom-nav__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    min-height: var(--minimum-touch-target, 44px);
    padding-block: 0.15rem;
    border: 0;
    background: transparent;
    color: #6b6b6b;
    text-decoration: none;
    font-family: inherit;
    cursor: pointer;
  }

  .mobile-bottom-nav__item--active {
    color: #111111;
  }

  .mobile-bottom-nav__icon {
    position: relative;
    display: inline-flex;
    width: 22px;
    height: 22px;
  }

  .mobile-bottom-nav__icon svg {
    width: 100%;
    height: 100%;
  }

  .mobile-bottom-nav__label {
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }

  cart-icon.mobile-bottom-nav__icon .cart-bubble {
    position: absolute;
    top: -4px;
    right: -6px;
    width: 16px;
  }
{% endstylesheet %}
