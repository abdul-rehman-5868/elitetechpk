{%- doc -%}
  Horizontal product row for predictive search modal.

  @param {object} product - Product resource
{%- enddoc -%}

{% liquid
  assign featured_image = product.featured_media.preview_image | default: product.featured_image
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
%}

<a class="predictive-search-row-product" href="{{ product.url }}">
  <span class="predictive-search-row-product__media">
    {% if featured_image != blank %}
      {{
        featured_image
        | image_url: width: 180
        | image_tag:
          loading: 'lazy',
          widths: '80, 120, 160, 180',
          sizes: '80px',
          alt: featured_image.alt
      }}
    {% else %}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'predictive-search-row-product__placeholder' }}
    {% endif %}
  </span>
  <span class="predictive-search-row-product__copy">
    <strong>{{ product.title }}</strong>
    <span class="predictive-search-row-product__price-row">
      {% if on_sale %}
        <span class="predictive-search-row-product__price predictive-search-row-product__price--sale">
          {{ product.price | money }}
        </span>
        <s class="predictive-search-row-product__compare">
          {{ product.compare_at_price | money }}
        </s>
      {% else %}
        <span class="predictive-search-row-product__price">
          {{ product.price | money }}
        </span>
      {% endif %}
    </span>
  </span>
</a>
